<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Arthiva.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Arthiva.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters — available by key in every page's bindings -->
            <converters:TransactionAmountColorConverter x:Key="TransactionAmountColorConverter" />
            <converters:TransactionAmountTextConverter x:Key="TransactionAmountTextConverter" />
            <converters:CurrencyConverter x:Key="CurrencyConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:CountToInverseBoolConverter x:Key="CountToInverseBoolConverter" />
            <converters:IntGreaterThanZeroConverter x:Key="IntGreaterThanZeroConverter" />
            <converters:SpentToBudgetRatioConverter x:Key="SpentToBudgetRatioConverter" />
            <converters:BudgetRatioToColorConverter x:Key="BudgetRatioToColorConverter" />
            <converters:BorrowLendTypeToColorConverter x:Key="BorrowLendTypeToColorConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

            <!-- These were missing — same "StaticResource not found" crash that hit
                 IsNotNullConverter on Android would eventually hit these too. -->
            <converters:InstallmentRatioConverter x:Key="InstallmentRatioConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:SpentToBudgetColorConverter x:Key="SpentToBudgetColorConverter" />
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <converters:StringEmptyConverter x:Key="StringEmptyConverter" />

            <converters:HexToColorConverter x:Key="HexToColorConverter" />
            <converters:HexToTintConverter  x:Key="HexToTintConverter" />
        </ResourceDictionary>
    </Application.Resources>

</Application>