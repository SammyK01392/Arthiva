<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MoneySpend.AppShell"
    x:Name="RootShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MoneySpend.Views"
    xmlns:converters="clr-namespace:MoneySpend.Converters"
    FlyoutBehavior="Disabled"

    Shell.NavBarIsVisible="True"
    Shell.NavBarHasShadow="False"

    Shell.BackgroundColor="White"
    Shell.ForegroundColor="#111827"
    Shell.TitleColor="#111827"
    Shell.DisabledColor="#C7CCD6"
    Shell.UnselectedColor="#9CA3AF"

    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#FF6A00"
    Shell.TabBarUnselectedColor="#9CA3AF"
    Shell.TabBarTitleColor="#FF6A00"
    Shell.TabBarDisabledColor="#C7CCD6"

    Title="MoneySpend">

    <Shell.Resources>
        <ResourceDictionary>
            <converters:IntGreaterThanZeroConverter
                x:Key="LocalIntGreaterThanZeroConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ═══════════ TOP APP BAR ═══════════ -->
    <Shell.TitleView>
        <Grid RowDefinitions="*,Auto" HeightRequest="60" BackgroundColor="White">

            <Grid Grid.Row="0"
                  Padding="16,0,16,0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  BackgroundColor="White">

                <!-- Brand mark -->
                <Border Grid.Column="0"
                        WidthRequest="36" HeightRequest="36"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF9A1F" Offset="0" />
                            <GradientStop Color="#FF5A00" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="₹"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="{Binding CurrentPageTitle, Source={x:Reference RootShell}}"
                       FontSize="20"
                       FontAttributes="Bold"
                       CharacterSpacing="-0.3"
                       TextColor="#111827"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center" />

                <!-- Bell -->
                <Grid Grid.Column="2"
                      WidthRequest="44"
                      HeightRequest="44"
                      HorizontalOptions="End"
                      VerticalOptions="Center">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBellTapped" />
                    </Grid.GestureRecognizers>

                    <Border BackgroundColor="#F6F7FB"
                            Stroke="#ECEEF3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                        <Path WidthRequest="18" HeightRequest="18"
                              Aspect="Uniform"
                              Fill="Transparent"
                              Stroke="#1F2937"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M18,8 C18,4.7 15.3,2 12,2 C8.7,2 6,4.7 6,8 C6,15 3,17 3,17 L21,17 C21,17 18,15 18,8 Z M13.7,21 C13.3,21.7 12.7,22 12,22 C11.3,22 10.7,21.7 10.3,21" />
                    </Border>

                    <!-- Unread badge -->
                    <Border IsVisible="{Binding UnreadNotificationCount,
                                        Source={x:Reference RootShell},
                                        Converter={StaticResource LocalIntGreaterThanZeroConverter}}"
                            BackgroundColor="#F97316"
                            Stroke="White"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 9"
                            MinimumWidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Padding="3,0">
                        <Border.Shadow>
                            <Shadow Brush="#F97316" Offset="0,2" Radius="6" Opacity="0.35" />
                        </Border.Shadow>
                        <Label Text="{Binding UnreadNotificationCount, Source={x:Reference RootShell}}"
                               TextColor="White"
                               FontSize="9.5"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Hairline -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     Color="#F0F1F5" />
        </Grid>
    </Shell.TitleView>

    <!-- ═══════════ BOTTOM NAVIGATION ═══════════ -->
    <TabBar>

        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />

        <ShellContent
            Title="Transactions"
            Icon="tab_transactions.png"
            ContentTemplate="{DataTemplate views:TransactionListPage}"
            Route="TransactionListPage" />

        <ShellContent
            Title="Add"
            Icon="tab_add.png"
            ContentTemplate="{DataTemplate views:AddPlaceholderPage}"
            Route="AddPlaceholderPage" />

        <ShellContent
            Title="Accounts"
            Icon="tab_accounts.png"
            ContentTemplate="{DataTemplate views:AccountListPage}"
            Route="AccountListPage" />

        <ShellContent
            Title="More"
            Icon="tab_more.png"
            ContentTemplate="{DataTemplate views:MorePage}"
            Route="MorePage" />

    </TabBar>

</Shell>