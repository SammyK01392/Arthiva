<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="Arthiva.AppShell"
    x:Name="RootShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Arthiva.Views"
    xmlns:converters="clr-namespace:Arthiva.Converters"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    BackgroundColor="{StaticResource Background}"
    Title="Arthiva">

    <Shell.Resources>
        <ResourceDictionary>
            <converters:IntGreaterThanZeroConverter
                x:Key="LocalIntGreaterThanZeroConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ===================================================== -->
    <!-- TOP APP BAR                                            -->
    <!-- ===================================================== -->

    <Shell.TitleView>

        <Grid
            Padding="18,0,12,0"
            ColumnDefinitions="*,Auto"
            HeightRequest="56">

            <Label
                Grid.Column="0"
                Text="{Binding Title, Source={x:Reference RootShell}}"
                Style="{StaticResource TitleLabel}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                VerticalOptions="Center" />

            <Grid
                Grid.Column="1"
                WidthRequest="44"
                HeightRequest="44"
                HorizontalOptions="End"
                VerticalOptions="Center">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnBellTapped" />
                </Grid.GestureRecognizers>

                <Border
                    BackgroundColor="{StaticResource Background}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    WidthRequest="42"
                    HeightRequest="42"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="🔔"
                        FontSize="19"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

                <Border
                    IsVisible="{Binding UnreadNotificationCount,
                        Source={x:Reference RootShell},
                        Converter={StaticResource LocalIntGreaterThanZeroConverter}}"
                    BackgroundColor="{StaticResource Expense}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 9"
                    WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    TranslationX="-1"
                    TranslationY="1"
                    Padding="0">

                    <Label
                        Text="{Binding UnreadNotificationCount,
                            Source={x:Reference RootShell}}"
                        TextColor="White"
                        FontSize="9"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

            </Grid>

        </Grid>

    </Shell.TitleView>


    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION                                      -->
    <!-- ===================================================== -->

    <TabBar>

        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />

        <ShellContent
            Title="Transactions"
            Icon="tab_transactions.png"
            ContentTemplate="{DataTemplate views:TransactionListPage}"
            Route="TransactionListPage" />

        <!-- Converters — available by key in every page's bindings 
        <ShellContent
            Title="Add"
            Icon="tab_add.png"
            ContentTemplate="{DataTemplate views:AddEditTransactionPage}"
            Route="AddEditTransactionPage" /> -->

        <ShellContent
            Title="Accounts"
            Icon="tab_accounts.png"
            ContentTemplate="{DataTemplate views:AccountListPage}"
            Route="AccountListPage" />

        <ShellContent
            Title="More"
            Icon="tab_more.png"
            ContentTemplate="{DataTemplate views:MorePage}"
            Route="MorePage" />

    </TabBar>

</Shell>