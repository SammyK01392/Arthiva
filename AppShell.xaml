<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Arthiva.AppShell"
    x:Name="RootShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Arthiva.Views"
    xmlns:converters="clr-namespace:Arthiva.Converters"
    FlyoutBehavior="Disabled"

    Shell.NavBarIsVisible="True"
    Shell.NavBarHasShadow="False"

    Shell.BackgroundColor="#F25C00"
    Shell.ForegroundColor="White"
    Shell.DisabledColor="#80FFFFFF"
    Shell.UnselectedColor="#CCFFFFFF"

    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"

    Title="Arthiva">

    <Shell.Resources>
        <ResourceDictionary>
            <converters:IntGreaterThanZeroConverter
                x:Key="LocalIntGreaterThanZeroConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  PREMIUM TOP APP BAR (White / Black text)           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Shell.TitleView>
        <Grid RowDefinitions="*,Auto" HeightRequest="60">

            <Grid Grid.Row="0"
              Padding="20,0,16,0"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="White">

                <!-- Small brand accent mark -->
                <BoxView Grid.Column="0"
                     WidthRequest="4"
                     HeightRequest="22"
                     CornerRadius="2"
                     Color="#F97316"
                     VerticalOptions="Center"
                     Margin="0,0,10,0" />

                <!-- Title -->
                <Label Grid.Column="1"
                   Text="{Binding CurrentPageTitle, Source={x:Reference RootShell}}"
                   FontSize="21"
                   FontAttributes="Bold"
                   CharacterSpacing="-0.4"
                   TextColor="#111111"
                   VerticalOptions="Center" />

                <!-- Bell -->
                <Grid Grid.Column="2"
                  WidthRequest="42"
                  HeightRequest="42"
                  HorizontalOptions="End"
                  VerticalOptions="Center">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBellTapped" />
                    </Grid.GestureRecognizers>

                    <Border BackgroundColor="#FAFAFA"
                        Stroke="#EFEFEF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 21"
                        WidthRequest="38"
                        HeightRequest="38"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Path WidthRequest="17" HeightRequest="17"
                          Aspect="Uniform"
                          Fill="Transparent"
                          Stroke="#2A2A2A"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Data="M18,8 C18,4.7 15.3,2 12,2 C8.7,2 6,4.7 6,8 C6,15 3,17 3,17 L21,17 C21,17 18,15 18,8 Z M13.7,21 C13.3,21.7 12.7,22 12,22 C11.3,22 10.7,21.7 10.3,21" />
                    </Border>

                    <Border IsVisible="{Binding UnreadNotificationCount,
                            Source={x:Reference RootShell},
                            Converter={StaticResource LocalIntGreaterThanZeroConverter}}"
                        BackgroundColor="#F97316"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="16"
                        HeightRequest="16"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        TranslationX="0"
                        TranslationY="1"
                        Padding="0">

                        <Label Text="{Binding UnreadNotificationCount, Source={x:Reference RootShell}}"
                           TextColor="White"
                           FontSize="9"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Soft shadow instead of flat border -->
            <BoxView Grid.Row="1"
                 HeightRequest="1"
                 Color="#F0F0F0" />
        </Grid>
    </Shell.TitleView>


    <!-- ═══════════════════════════════════════════════════ -->
    <!--  BOTTOM NAVIGATION                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <TabBar>

        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />

        <ShellContent
            Title="Transactions"
            Icon="tab_transactions.png"
            ContentTemplate="{DataTemplate views:TransactionListPage}"
            Route="TransactionListPage" />

        <ShellContent
            Title="Accounts"
            Icon="tab_accounts.png"
            ContentTemplate="{DataTemplate views:AccountListPage}"
            Route="AccountListPage" />

        <ShellContent
            Title="More"
            Icon="tab_more.png"
            ContentTemplate="{DataTemplate views:MorePage}"
            Route="MorePage" />

    </TabBar>

</Shell>