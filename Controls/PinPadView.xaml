<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="MoneySpend.Controls.PinPadView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="PinKeyBorderStyle" TargetType="Border">
                <Setter Property="WidthRequest" Value="72" />
                <Setter Property="HeightRequest" Value="72" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#F3E6D8" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 36" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#FF6B00" Opacity="0.14" Offset="0,6" Radius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PinKeyLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#1A1410" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <Style x:Key="PinDotStyle" TargetType="Border">
                <Setter Property="WidthRequest" Value="16" />
                <Setter Property="HeightRequest" Value="16" />
                <Setter Property="Stroke" Value="#FF6B00" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="30" HorizontalOptions="Center">

        <!-- PIN dots -->
        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            <Border x:Name="Dot1" Style="{StaticResource PinDotStyle}" />
            <Border x:Name="Dot2" Style="{StaticResource PinDotStyle}" />
            <Border x:Name="Dot3" Style="{StaticResource PinDotStyle}" />
            <Border x:Name="Dot4" Style="{StaticResource PinDotStyle}" />
        </HorizontalStackLayout>

        <!-- Keypad -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,Auto,Auto"
              RowSpacing="20"
              ColumnSpacing="30"
              HorizontalOptions="Center">

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="1" />
                </Border.GestureRecognizers>
                <Label Text="1" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="2" />
                </Border.GestureRecognizers>
                <Label Text="2" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="3" />
                </Border.GestureRecognizers>
                <Label Text="3" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="4" />
                </Border.GestureRecognizers>
                <Label Text="4" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="5" />
                </Border.GestureRecognizers>
                <Label Text="5" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="6" />
                </Border.GestureRecognizers>
                <Label Text="6" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="7" />
                </Border.GestureRecognizers>
                <Label Text="7" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="8" />
                </Border.GestureRecognizers>
                <Label Text="8" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="9" />
                </Border.GestureRecognizers>
                <Label Text="9" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>

            <BoxView Grid.Row="3" Grid.Column="0"
                     Color="Transparent"
                     WidthRequest="72" HeightRequest="72"
                     InputTransparent="True" />

            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource PinKeyBorderStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDigitTapped" CommandParameter="0" />
                </Border.GestureRecognizers>
                <Label Text="0" Style="{StaticResource PinKeyLabelStyle}" />
            </Border>

            <Border Grid.Row="3" Grid.Column="2"
                    WidthRequest="72" HeightRequest="72"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 36"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackspaceTapped" />
                </Border.GestureRecognizers>
                <Path WidthRequest="28" HeightRequest="28"
                      Aspect="Uniform"
                      Fill="Transparent"
                      Stroke="#FF6B00"
                      StrokeThickness="1.8"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True"
                      Data="M9,4 L3,12 L9,20 L21,20 C21.55,20 22,19.55 22,19 L22,5 C22,4.45 21.55,4 21,4 Z M13,9 L18,14 M18,9 L13,14" />
            </Border>

        </Grid>
    </VerticalStackLayout>
</ContentView>