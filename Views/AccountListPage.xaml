<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.AccountListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    xmlns:components="clr-namespace:Arthiva.Views.Components"
    x:DataType="vm:AccountListViewModel"
    Title="Accounts">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <Grid>

            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="0">
                    <CollectionView ItemsSource="{Binding Accounts}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Account">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Default"
                                                       BackgroundColor="{StaticResource Primary}"
                                                       Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SetDefaultCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="{StaticResource Expense}"
                                                       Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Grid>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Border Style="{StaticResource CardBorder}" Margin="0,6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                                <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource SubtitleLabel}"
                                                       Text="{Binding Name}" />

                                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipBorder}"
                                                        BackgroundColor="{StaticResource PrimaryTint}"
                                                        IsVisible="{Binding IsDefault}">
                                                    <Label Style="{StaticResource ChipLabel}" TextColor="{StaticResource Primary}" Text="Default" />
                                                </Border>

                                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Style="{StaticResource CaptionLabel}"
                                                       Text="{Binding Type}" />

                                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                       FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                                       Text="{Binding CurrentBalance, StringFormat='₹{0:N2}'}" />

                                            </Grid>
                                        </Border>
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                IsVisible="{Binding Accounts.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                <Label Text="No accounts yet. Tap + Add to create one." Style="{StaticResource BodyLabel}"
                       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <ActivityIndicator Style="{StaticResource LoadingIndicator}"
                                IsVisible="{Binding IsBusy}"
                                VerticalOptions="Center" HorizontalOptions="Center" />

            <Button Style="{StaticResource FabButton}" Text="+" Command="{Binding GoToAddCommand}" />

        </Grid>
    </RefreshView>

</ContentPage>
