<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.AppLockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Arthiva.Controls"
    BackgroundColor="#FFFFFF"
    Shell.NavBarIsVisible="False">

    <Grid Padding="28,64,28,32" RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══════════════════════════════════════════ -->
        <!--  BRANDING                                    -->
        <!-- ═══════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" HorizontalOptions="Center">
            <Border BackgroundColor="#FFF1E3"
                    WidthRequest="56" HeightRequest="56"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Center">
                <Label Text="A"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#FF6B00"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="ARTHIVA"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   TextColor="#FF6B00"
                   Margin="0,10,0,0"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!--  WELCOME + PROMPT                            -->
        <!-- ═══════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="1" Margin="0,28,0,0" Spacing="6" HorizontalOptions="Center">
            <Label Text="Welcome back"
                   FontSize="15"
                   TextColor="#7A6B5E"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="UserNameLabel"
                   Text=" "
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center" />

            <Label Text="Enter your 4-digit PIN"
                   FontSize="14"
                   TextColor="#7A6B5E"
                   Margin="0,10,0,0"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="ErrorLabel"
                   Text="Incorrect PIN. Please try again."
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#DC2626"
                   IsVisible="False"
                   Margin="0,8,0,0"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!--  PIN PAD                                     -->
        <!-- ═══════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="2" VerticalOptions="Center">
            <controls:PinPadView x:Name="PinPad" PinChanged="OnPinPadChanged" />
            <ActivityIndicator x:Name="VerifyingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#FF6B00"
                               Margin="0,20,0,0" />
        </VerticalStackLayout>

        <Label Grid.Row="3"
               Text="Your data stays secured on this device."
               FontSize="12"
               TextColor="#7A6B5E"
               HorizontalTextAlignment="Center" />

    </Grid>

</ContentPage>
