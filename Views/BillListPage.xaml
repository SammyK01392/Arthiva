<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.BillListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    x:DataType="vm:BillListViewModel"
    Title="Bills"
    BackgroundColor="#FFF8F2">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#FF6B00</Color>
            <Color x:Key="PrimaryTint">#FFF1E3</Color>
            <Color x:Key="PageBg">#FFF8F2</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#F4EBE1</Color>
            <Color x:Key="TrackMuted">#F4EDE6</Color>
            <Color x:Key="TextPrimary">#1A1410</Color>
            <Color x:Key="TextSecondary">#7A6B5E</Color>
            <Color x:Key="TextTertiary">#A89A8C</Color>
            <Color x:Key="Paid">#0FA968</Color>
            <Color x:Key="PaidTint">#E3F7EE</Color>
            <Color x:Key="PaidDeep">#C6EFDC</Color>
            <Color x:Key="Pending">#F59E0B</Color>
            <Color x:Key="PendingTint">#FEF3C7</Color>
            <Color x:Key="PendingDeep">#FFE0C2</Color>
            <Color x:Key="Overdue">#E63946</Color>
            <Color x:Key="OverdueTint">#FDECEE</Color>
            <Color x:Key="OverdueDeep">#FAD5DA</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid RowDefinitions="Auto,*">

            <!-- ═══════════ COMPACT PREMIUM HEADER ═══════════ -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8A1E" Offset="0.0" />
                        <GradientStop Color="#FF6B00" Offset="0.55" />
                        <GradientStop Color="#F25600" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Decorative SVG layer -->
                <Grid InputTransparent="True">
                    <Ellipse WidthRequest="100" HeightRequest="100"
                             Fill="#30FFFFFF"
                             HorizontalOptions="Start" VerticalOptions="Start"
                             TranslationX="-40" TranslationY="-40" />

                    <Ellipse WidthRequest="140" HeightRequest="140"
                             Fill="#40FFFFFF"
                             HorizontalOptions="End" VerticalOptions="End"
                             TranslationX="60" TranslationY="60" />

                    <Path Stroke="#28FFFFFF" StrokeThickness="1.3" Fill="Transparent"
                          HorizontalOptions="End" VerticalOptions="Center"
                          TranslationX="20"
                          Data="M0,0 C 40,30 40,100 0,130" />

                    <HorizontalStackLayout Spacing="6"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="20,18,0,0">
                        <Ellipse WidthRequest="3" HeightRequest="3" Fill="#66FFE0C2" />
                        <Ellipse WidthRequest="3" HeightRequest="3" Fill="#40FFFFFF" />
                        <Ellipse WidthRequest="3" HeightRequest="3" Fill="#40FFFFFF" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Header content — compact -->
                <Grid Padding="20,16,20,18" ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="3">

                        <Border Padding="7,3"
                                StrokeThickness="0"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="#40FFFFFF">
                            <HorizontalStackLayout Spacing="4">
                                <Ellipse WidthRequest="4" HeightRequest="4"
                                         Fill="#FFE0C2"
                                         VerticalOptions="Center" />
                                <Label Text="BILL MANAGER"
                                       FontSize="8.5"
                                       CharacterSpacing="1.8"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="#FFE0C2" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="Your Bills"
                               FontSize="22"
                               FontAttributes="Bold"
                               Margin="0,4,0,0"
                               TextColor="White" />

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Track payments,"
                                   FontSize="11"
                                   TextColor="#FFE0C2" />
                            <Label Text="never miss a due"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Receipt SVG badge — smaller -->
                    <Border Grid.Column="1"
                            WidthRequest="42" HeightRequest="42"
                            StrokeThickness="1"
                            Stroke="#40FFFFFF"
                            VerticalOptions="Center"
                            StrokeShape="RoundRectangle 13"
                            BackgroundColor="#40FFFFFF">
                        <Path WidthRequest="20" HeightRequest="20"
                              Aspect="Uniform"
                              Fill="Transparent"
                              Stroke="White"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M6,2 L18,2 L18,22 L15,20 L12,22 L9,20 L6,22 Z M9,8 L15,8 M9,12 L15,12 M9,16 L13,16" />
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════ CONTENT SHEET ═══════════ -->
            <Border Grid.Row="1" Margin="0,-12,0,0"
                    StrokeThickness="0" BackgroundColor="{StaticResource PageBg}"
                    StrokeShape="RoundRectangle 26,26,0,0">
                <Grid RowDefinitions="Auto,*">

                    <!-- ═══ FILTER TABS ═══ -->
                    <Border Grid.Row="0" Margin="16,16,16,10" Padding="4"
                            StrokeThickness="0" BackgroundColor="{StaticResource TrackMuted}"
                            StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">

                            <!-- ALL -->
                            <Border Grid.Column="0" Padding="2,10" StrokeThickness="0"
                                    BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedFilter}" Value="All">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.Shadow>
                                    <Shadow Brush="#FF6B00" Offset="0,3" Radius="8" Opacity="0.28" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="All" />
                                </Border.GestureRecognizers>
                                <Label Text="All" FontSize="12.5" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="All">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- UPCOMING -->
                            <Border Grid.Column="1" Padding="2,10" StrokeThickness="0"
                                    BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedFilter}" Value="Upcoming">
                                        <Setter Property="BackgroundColor" Value="#7C3AED" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.Shadow>
                                    <Shadow Brush="#7C3AED" Offset="0,3" Radius="8" Opacity="0.30" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Upcoming" />
                                </Border.GestureRecognizers>
                                <Label Text="Upcoming" FontSize="12.5" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="Upcoming">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- OVERDUE -->
                            <Border Grid.Column="2" Padding="2,10" StrokeThickness="0"
                                    BackgroundColor="Transparent" StrokeShape="RoundRectangle 10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedFilter}" Value="Overdue">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Overdue}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.Shadow>
                                    <Shadow Brush="#E63946" Offset="0,3" Radius="8" Opacity="0.30" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Overdue" />
                                </Border.GestureRecognizers>
                                <Label Text="Overdue" FontSize="12.5" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="Overdue">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ═══ List ═══ -->
                    <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}"
                                 Command="{Binding LoadCommand}"
                                 RefreshColor="{StaticResource Primary}">
                        <Grid>
                            <CollectionView ItemsSource="{Binding Bills}"
                                            SelectionMode="None"
                                            VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Bill">

                                        <SwipeView Margin="16,0,16,10">

                                            <!-- ══════════════════════════════════════════ -->
                                            <!-- LEFT SWIPE (finger →) → EDIT (Purple)    -->
                                            <!-- ══════════════════════════════════════════ -->
                                            <SwipeView.LeftItems>
                                                <SwipeItems Mode="Reveal"
                                                            SwipeBehaviorOnInvoked="Close">

                                                    <SwipeItemView>
                                                        <Grid WidthRequest="88"
                                                              BackgroundColor="#7C3AED">
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Grid.GestureRecognizers>

                                                            <VerticalStackLayout
                                                                VerticalOptions="Center"
                                                                HorizontalOptions="Center"
                                                                Spacing="6">
                                                                <Border WidthRequest="36" HeightRequest="36"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 18"
                                                                        BackgroundColor="#33FFFFFF"
                                                                        HorizontalOptions="Center">
                                                                    <Path WidthRequest="18" HeightRequest="18"
                                                                          Aspect="Uniform"
                                                                          Fill="Transparent"
                                                                          Stroke="White"
                                                                          StrokeThickness="2"
                                                                          StrokeLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          HorizontalOptions="Center"
                                                                          VerticalOptions="Center"
                                                                          Data="M14.06,9 L15,9.94 L5.92,19 H5 V18.08 L14.06,9 M17.66,3 C17.41,3 17.15,3.1 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C18.17,3.09 17.92,3 17.66,3 M14.06,6.19 L3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z" />
                                                                </Border>
                                                                <Label Text="Edit"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </SwipeItemView>

                                                </SwipeItems>
                                            </SwipeView.LeftItems>

                                            <!-- ══════════════════════════════════════════ -->
                                            <!-- RIGHT SWIPE (finger ←) → DELETE (Red)     -->
                                            <!-- ══════════════════════════════════════════ -->
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal"
                                                            SwipeBehaviorOnInvoked="Close">

                                                    <SwipeItemView>
                                                        <Grid WidthRequest="88"
                                                              BackgroundColor="#E63946">
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Grid.GestureRecognizers>

                                                            <VerticalStackLayout
                                                                VerticalOptions="Center"
                                                                HorizontalOptions="Center"
                                                                Spacing="6">
                                                                <Border WidthRequest="36" HeightRequest="36"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 18"
                                                                        BackgroundColor="#33FFFFFF"
                                                                        HorizontalOptions="Center">
                                                                    <Image Source="icon_delete_white.png"
                                                                           WidthRequest="18" HeightRequest="18"
                                                                           Aspect="AspectFit"
                                                                           HorizontalOptions="Center"
                                                                           VerticalOptions="Center" />
                                                                </Border>
                                                                <Label Text="Delete"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </SwipeItemView>

                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <!-- ══════════════════════════════════════════ -->
                                            <!-- PREMIUM BILL CARD                          -->
                                            <!-- ══════════════════════════════════════════ -->
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 16">
                                                <Border.Shadow>
                                                    <Shadow Brush="#3D1E00" Offset="0,6" Radius="16" Opacity="0.08" />
                                                </Border.Shadow>

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>

                                                <Grid ColumnDefinitions="5,*" ColumnSpacing="0"
                                                      BackgroundColor="{StaticResource CardBg}">

                                                    <!-- LEFT STATUS ACCENT -->
                                                    <BoxView Grid.Column="0"
                                                             Color="{StaticResource Pending}"
                                                             VerticalOptions="Fill">
                                                        <BoxView.Triggers>
                                                            <DataTrigger TargetType="BoxView"
                                                                         Binding="{Binding Status}" Value="Paid">
                                                                <Setter Property="Color" Value="{StaticResource Paid}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="BoxView"
                                                                         Binding="{Binding Status}" Value="Overdue">
                                                                <Setter Property="Color" Value="{StaticResource Overdue}" />
                                                            </DataTrigger>
                                                        </BoxView.Triggers>
                                                    </BoxView>

                                                    <!-- MAIN CONTENT -->
                                                    <Grid Grid.Column="1"
                                                          Padding="14,12"
                                                          ColumnDefinitions="44,*,Auto"
                                                          ColumnSpacing="12">

                                                        <!-- CALENDAR SVG ICON -->
                                                        <Border Grid.Column="0"
                                                                WidthRequest="44" HeightRequest="44"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center"
                                                                StrokeShape="RoundRectangle 12">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="{StaticResource PrimaryTint}" Offset="0.0" />
                                                                    <GradientStop Color="{StaticResource PendingDeep}" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding Status}" Value="Paid">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <GradientStop Color="{StaticResource PaidTint}" Offset="0.0" />
                                                                                <GradientStop Color="{StaticResource PaidDeep}" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding Status}" Value="Overdue">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <GradientStop Color="{StaticResource OverdueTint}" Offset="0.0" />
                                                                                <GradientStop Color="{StaticResource OverdueDeep}" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Border.Triggers>

                                                            <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                                                <Path WidthRequest="22" HeightRequest="22"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource Primary}"
                                                                      StrokeThickness="1.9"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Data="M5,7 L5,19 C5,20.1 5.9,21 7,21 L17,21 C18.1,21 19,20.1 19,19 L19,7 C19,5.9 18.1,5 17,5 L7,5 C5.9,5 5,5.9 5,7 Z M5,10 L19,10 M9,3 L9,7 M15,3 L15,7">
                                                                    <Path.Triggers>
                                                                        <DataTrigger TargetType="Path"
                                                                                     Binding="{Binding Status}" Value="Paid">
                                                                            <Setter Property="Stroke" Value="{StaticResource Paid}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Path"
                                                                                     Binding="{Binding Status}" Value="Overdue">
                                                                            <Setter Property="Stroke" Value="{StaticResource Overdue}" />
                                                                        </DataTrigger>
                                                                    </Path.Triggers>
                                                                </Path>
                                                            </Grid>
                                                        </Border>

                                                        <!-- NAME + META -->
                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="5"
                                                                             VerticalOptions="Center">

                                                            <Label FontSize="14.5" FontAttributes="Bold"
                                                                   LineBreakMode="TailTruncation" MaxLines="1"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding Name, TargetNullValue='Bill'}" />

                                                            <HorizontalStackLayout Spacing="7">
                                                                <Label FontSize="11"
                                                                       TextColor="{StaticResource TextSecondary}"
                                                                       VerticalOptions="Center"
                                                                       Text="{Binding DueDate, StringFormat='Due {0:dd MMM}'}" />

                                                                <BoxView WidthRequest="3" HeightRequest="3"
                                                                         CornerRadius="1.5"
                                                                         VerticalOptions="Center"
                                                                         Color="{StaticResource TextTertiary}" />

                                                                <!-- Status pill -->
                                                                <Border Padding="6,2"
                                                                        StrokeThickness="0"
                                                                        VerticalOptions="Center"
                                                                        StrokeShape="RoundRectangle 6"
                                                                        BackgroundColor="{StaticResource PendingTint}">
                                                                    <Border.Triggers>
                                                                        <DataTrigger TargetType="Border"
                                                                                     Binding="{Binding Status}" Value="Paid">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource PaidTint}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Border"
                                                                                     Binding="{Binding Status}" Value="Overdue">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource OverdueTint}" />
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                    <HorizontalStackLayout Spacing="4">
                                                                        <Ellipse WidthRequest="5" HeightRequest="5"
                                                                                 Fill="{StaticResource Pending}"
                                                                                 VerticalOptions="Center">
                                                                            <Ellipse.Triggers>
                                                                                <DataTrigger TargetType="Ellipse"
                                                                                             Binding="{Binding Status}" Value="Paid">
                                                                                    <Setter Property="Fill" Value="{StaticResource Paid}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger TargetType="Ellipse"
                                                                                             Binding="{Binding Status}" Value="Overdue">
                                                                                    <Setter Property="Fill" Value="{StaticResource Overdue}" />
                                                                                </DataTrigger>
                                                                            </Ellipse.Triggers>
                                                                        </Ellipse>
                                                                        <Label FontSize="9.5" FontAttributes="Bold"
                                                                               VerticalOptions="Center"
                                                                               TextColor="{StaticResource Pending}"
                                                                               Text="{Binding Status}">
                                                                            <Label.Triggers>
                                                                                <DataTrigger TargetType="Label"
                                                                                             Binding="{Binding Status}" Value="Paid">
                                                                                    <Setter Property="TextColor" Value="{StaticResource Paid}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger TargetType="Label"
                                                                                             Binding="{Binding Status}" Value="Overdue">
                                                                                    <Setter Property="TextColor" Value="{StaticResource Overdue}" />
                                                                                </DataTrigger>
                                                                            </Label.Triggers>
                                                                        </Label>
                                                                    </HorizontalStackLayout>
                                                                </Border>
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>

                                                        <!-- AMOUNT + PAY BUTTON -->
                                                        <VerticalStackLayout Grid.Column="2"
                                                                             Spacing="6"
                                                                             VerticalOptions="Center"
                                                                             HorizontalOptions="End">

                                                            <Label FontSize="16.5" FontAttributes="Bold"
                                                                   HorizontalTextAlignment="End"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" />

                                                            <Border Padding="10,4"
                                                                    StrokeThickness="0"
                                                                    HorizontalOptions="End"
                                                                    StrokeShape="RoundRectangle 8">
                                                                <Border.Shadow>
                                                                    <Shadow Brush="#FF6B00" Offset="0,3" Radius="8" Opacity="0.35" />
                                                                </Border.Shadow>
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#FF8A1E" Offset="0.0" />
                                                                        <GradientStop Color="#FF5500" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border"
                                                                                 Binding="{Binding Status}" Value="Paid">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="{StaticResource PaidTint}" Offset="0.0" />
                                                                                    <GradientStop Color="{StaticResource PaidDeep}" Offset="1.0" />
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="Shadow">
                                                                            <Setter.Value>
                                                                                <Shadow Brush="Transparent" Offset="0,0" Radius="0" Opacity="0" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToPayCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Border.GestureRecognizers>

                                                                <HorizontalStackLayout Spacing="4">
                                                                    <Path WidthRequest="11" HeightRequest="11"
                                                                          Aspect="Uniform"
                                                                          Fill="White"
                                                                          HorizontalOptions="Center"
                                                                          VerticalOptions="Center"
                                                                          Data="M13,2 L6,13 L11,13 L10,22 L17,11 L12,11 Z">
                                                                        <Path.Triggers>
                                                                            <DataTrigger TargetType="Path"
                                                                                         Binding="{Binding Status}" Value="Paid">
                                                                                <Setter Property="Fill" Value="{StaticResource Paid}" />
                                                                                <Setter Property="Data" Value="M4,12 L9,17 L20,6" />
                                                                                <Setter Property="Stroke" Value="{StaticResource Paid}" />
                                                                                <Setter Property="StrokeThickness" Value="2.5" />
                                                                                <Setter Property="StrokeLineCap" Value="Round" />
                                                                                <Setter Property="StrokeLineJoin" Value="Round" />
                                                                            </DataTrigger>
                                                                        </Path.Triggers>
                                                                    </Path>

                                                                    <Label Text="Pay"
                                                                           FontSize="11"
                                                                           FontAttributes="Bold"
                                                                           VerticalOptions="Center"
                                                                           TextColor="White">
                                                                        <Label.Triggers>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding Status}" Value="Paid">
                                                                                <Setter Property="Text" Value="Paid" />
                                                                                <Setter Property="TextColor" Value="{StaticResource Paid}" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </HorizontalStackLayout>
                                                            </Border>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </SwipeView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.Footer>
                                    <BoxView HeightRequest="110" Color="Transparent" />
                                </CollectionView.Footer>
                            </CollectionView>

                            <!-- Empty state -->
                            <VerticalStackLayout Padding="32" Spacing="12"
                                                 HorizontalOptions="Center" VerticalOptions="Center"
                                                 IsVisible="{Binding Bills.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                                <Border WidthRequest="80" HeightRequest="80"
                                        StrokeThickness="0" HorizontalOptions="Center"
                                        StrokeShape="RoundRectangle 26"
                                        BackgroundColor="{StaticResource PrimaryTint}">
                                    <Path WidthRequest="34" HeightRequest="34"
                                          Aspect="Uniform"
                                          Fill="Transparent"
                                          Stroke="{StaticResource Primary}"
