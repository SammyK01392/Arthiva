<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MoneySpend.Views.BorrowLendEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MoneySpend.ViewModels"
    xmlns:controls="clr-namespace:MoneySpend.Controls"
    x:DataType="vm:BorrowLendEditViewModel"
    Title="{Binding Title}">

    <!-- Root Grid: form neeche, popup uske upar overlay -->
    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Lend / Borrow toggle -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="I'm Lending"
                            Command="{Binding SetTypeCommand}" CommandParameter="Lend">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Type}" Value="Lend">
                                <Setter Property="BackgroundColor" Value="{StaticResource Expense}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Type}" Value="Borrow">
                                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="I'm Borrowing"
                            Command="{Binding SetTypeCommand}" CommandParameter="Borrow">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Type}" Value="Borrow">
                                <Setter Property="BackgroundColor" Value="{StaticResource Income}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Type}" Value="Lend">
                                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <Label Style="{StaticResource FormLabel}" Text="CONTACT" />
                <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding Contacts}"
                        ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedContact}" />
                <!-- Add new contact: compact chip -->
                <Border HorizontalOptions="Start" Margin="0,-4,0,0" Padding="12,7"
                        BackgroundColor="#FFF1E3"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="Add new contact">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAddContactCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="6">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Fill="{StaticResource Primary}" Aspect="Uniform"
                              WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                        <Label Text="New contact" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Label Style="{StaticResource FormLabel}" Text="AMOUNT" />
                <Entry Style="{StaticResource FormEntry}" Text="{Binding TotalAmount}" Keyboard="Numeric"
                       FontSize="22" FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Style="{StaticResource FormLabel}" Text="DATE GIVEN" />
                        <DatePicker Style="{StaticResource FormDatePicker}" Date="{Binding GivenDate}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Style="{StaticResource FormLabel}" Text="DUE DATE (OPTIONAL)" />
                        <DatePicker Style="{StaticResource FormDatePicker}" Date="{Binding DueDate}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Style="{StaticResource FormLabel}" Text="VIA ACCOUNT (OPTIONAL)" />
                <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding Accounts}"
                        ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedAccount}" />
                <Label Style="{StaticResource CaptionLabel}" Text="When set, a matching transaction is recorded on this account." />

                <Label Style="{StaticResource FormLabel}" Text="PAYMENT METHOD" />
                <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource BodyLabel}" FontAttributes="Bold"
                           Text="Remind me before due date" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding ReminderEnabled}" OnColor="{StaticResource Primary}" />
                </Grid>

                <Label Style="{StaticResource FormLabel}" Text="NOTES (OPTIONAL)" />
                <Editor Style="{StaticResource FormEditor}" Text="{Binding Notes}" HeightRequest="80" />

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <Button Style="{StaticResource PrimaryButton}" Text="Save"
                        Command="{Binding SaveCommand}" Margin="0,10,0,0" />
                <Button Style="{StaticResource TextButton}" Text="Cancel"
                        Command="{Binding CancelCommand}" HorizontalOptions="Center" />

                <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Success popup (hamesha last child, taaki sabse upar rahe) -->
        <controls:TransactionSuccessPopup x:Name="SuccessPopup" />

    </Grid>

</ContentPage>
