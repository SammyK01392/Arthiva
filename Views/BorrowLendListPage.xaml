<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.BorrowLendListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:components="clr-namespace:Arthiva.Views.Components"
    x:DataType="vm:BorrowLendListViewModel"
    Title="Borrow / Lend">

    <Grid>
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12">

        <!-- Net summary: total you'll receive (Lend) vs total you owe (Borrow) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,12">
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource CaptionLabel}" Text="You'll Receive" />
                    <Label FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Income}"
                           Text="{Binding TotalYouWillReceive, StringFormat='₹{0:N2}'}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource CaptionLabel}" Text="You Owe" />
                    <Label FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Expense}"
                           Text="{Binding TotalYouOwe, StringFormat='₹{0:N2}'}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- All / Lend / Borrow tabs -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,0,0,12"
                                BindableLayout.ItemsSource="{Binding Tabs}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource ChipBorder}" Padding="16,6">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectedTab}" Value="{Binding .}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SetTabCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource ChipLabel}" Text="{Binding .}" TextColor="{StaticResource TextPrimary}" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Records}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BorrowLendListItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Settle"
                                                   BackgroundColor="{StaticResource Primary}"
                                                   Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToRecordTransactionCommand}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="{StaticResource Expense}"
                                                   Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource CardBorder}" Margin="0,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToRecordTransactionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource SubtitleLabel}" Text="{Binding ContactName}" />

                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipBorder}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Record.Status}" Value="Overdue">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ExpenseTint}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Record.Status}" Value="Pending">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource WarningTint}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Style="{StaticResource ChipLabel}" Text="{Binding Record.Status}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Record.Status}" Value="Overdue">
                                                        <Setter Property="TextColor" Value="{StaticResource Expense}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Record.Status}" Value="Pending">
                                                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <!-- Lend/Borrow badge — needed once the "All" tab mixes both types -->
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChipBorder}"
                                                HorizontalOptions="Start" Padding="10,2">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Record.Type}" Value="Lend">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource ExpenseTint}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Record.Type}" Value="Borrow">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource IncomeTint}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Style="{StaticResource ChipLabel}" FontSize="10" Text="{Binding Record.Type}"
                                                   TextColor="{Binding Record.Type, Converter={StaticResource BorrowLendTypeToColorConverter}}" />
                                        </Border>

                                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CaptionLabel}"
                                               Text="{Binding Record.DueDate, StringFormat='Due {0:dd MMM yyyy}'}"
                                               IsVisible="{Binding Record.DueDate, Converter={StaticResource IsNotNullConverter}}" />

                                        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="{Binding Record.Type, Converter={StaticResource BorrowLendTypeToColorConverter}}"
                                               Text="{Binding Record.PendingAmount, Converter={StaticResource CurrencyConverter}}" />
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                    IsVisible="{Binding Records.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                    <Label Text="Nothing here yet." Style="{StaticResource BodyLabel}"
                           TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </RefreshView>

    </Grid>

        <Button Style="{StaticResource FabButton}" Text="+" Command="{Binding GoToAddCommand}" />
    </Grid>

</ContentPage>
