<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.BudgetEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    x:DataType="vm:BudgetEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource FormLabel}" Text="CATEGORY" />
            <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding ExpenseCategories}"
                    ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCategory}" />

            <Label Style="{StaticResource FormLabel}" Text="BUDGET AMOUNT" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding BudgetAmount}" Keyboard="Numeric"
                   FontSize="22" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Style="{StaticResource FormLabel}" Text="MONTH" />
                    <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Style="{StaticResource FormLabel}" Text="YEAR" />
                    <Entry Style="{StaticResource FormEntry}" Text="{Binding Year}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>

            <Label Style="{StaticResource FormLabel}" Text="ALERT THRESHOLD (%)" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding AlertPercentage}" Keyboard="Numeric" />
            <Label Style="{StaticResource CaptionLabel}" Text="You'll be notified when spending crosses this percentage of the budget." />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Style="{StaticResource BodyLabel}" FontAttributes="Bold"
                       Text="Enable notifications" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" OnColor="{StaticResource Primary}" />
            </Grid>

            <Label Style="{StaticResource FormLabel}" Text="NOTES (OPTIONAL)" />
            <Editor Style="{StaticResource FormEditor}" Text="{Binding Notes}" HeightRequest="70" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Style="{StaticResource PrimaryButton}" Text="Save Budget"
                    Command="{Binding SaveCommand}" Margin="0,10,0,0" />
            <Button Style="{StaticResource TextButton}" Text="Cancel"
                    Command="{Binding CancelCommand}" HorizontalOptions="Center" />

            <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
