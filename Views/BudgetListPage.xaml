<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.BudgetListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    x:DataType="vm:BudgetListViewModel"
    Title="Budgets"
    BackgroundColor="#FFFFFF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#FF6B00</Color>
            <Color x:Key="PrimaryTint">#FFFFFF</Color>
            <Color x:Key="PageBg">#FFFFFF</Color>
            <Color x:Key="CardBg">#FFF8F2</Color>
            <Color x:Key="CardStroke">#F4EBE1</Color>
            <Color x:Key="TrackMuted">#F4EDE6</Color>
            <Color x:Key="TextPrimary">#1A1410</Color>
            <Color x:Key="TextSecondary">#7A6B5E</Color>
            <Color x:Key="TextTertiary">#A89A8C</Color>
            <Color x:Key="Safe">#0FA968</Color>
            <Color x:Key="SafeTint">#E3F7EE</Color>
            <Color x:Key="SafeDeep">#C6EFDC</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="WarningTint">#FEF3C7</Color>
            <Color x:Key="WarningDeep">#FFE0C2</Color>
            <Color x:Key="Danger">#E63946</Color>
            <Color x:Key="DangerTint">#FDECEE</Color>
            <Color x:Key="DangerDeep">#FAD5DA</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid RowDefinitions="Auto,*">


            <!-- ═══════════ CONTENT SHEET ═══════════ -->
            <Border Grid.Row="1" Margin="0,-14,0,0"
                    StrokeThickness="0" BackgroundColor="{StaticResource PageBg}"
                    StrokeShape="RoundRectangle 28,28,0,0">
                <Grid RowDefinitions="*">

                    <RefreshView Grid.Row="0"
                                 IsRefreshing="{Binding IsBusy}"
                                 Command="{Binding LoadCommand}"
                                 RefreshColor="{StaticResource Primary}">
                        <Grid>
                            <CollectionView ItemsSource="{Binding Budgets}"
                                            SelectionMode="None"
                                            VerticalScrollBarVisibility="Never"
                                            Margin="16,20,16,0">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="32" Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Margin="0,60,0,0">
                                        <Border WidthRequest="80" HeightRequest="80"
                                                StrokeThickness="0" HorizontalOptions="Center"
                                                StrokeShape="RoundRectangle 26"
                                                BackgroundColor="{StaticResource PrimaryTint}">
                                            <Path WidthRequest="34" HeightRequest="34"
                                                  Aspect="Uniform"
                                                  Fill="Transparent"
                                                  Stroke="{StaticResource Primary}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M3,7 L3,17 C3,18.1 3.9,19 5,19 L19,19 C20.1,19 21,18.1 21,17 L21,7 M3,7 L21,7 M3,7 L17,3 L21,7 M16,12 L20,12" />
                                        </Border>
                                        <Label Text="No budgets yet" FontSize="16"
                                               FontAttributes="Bold" HorizontalOptions="Center"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="Tap + to set your first budget."
                                               FontSize="12.5" HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BudgetListItem">

                                        <SwipeView Margin="0,0,0,12">

                                            <!-- ══════════════════════════════════════════ -->
                                            <!-- LEFT SWIPE (finger →) → EDIT (Orange)    -->
                                            <!-- ══════════════════════════════════════════ -->
                                            <SwipeView.LeftItems>
                                                <SwipeItems Mode="Reveal"
                                                            SwipeBehaviorOnInvoked="Close">

                                                    <SwipeItemView>
                                                        <Grid WidthRequest="88"
                                                              BackgroundColor="#FF6B00">
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Grid.GestureRecognizers>

                                                            <VerticalStackLayout
                                                                VerticalOptions="Center"
                                                                HorizontalOptions="Center"
                                                                Spacing="6">
                                                                <Border WidthRequest="36" HeightRequest="36"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 18"
                                                                        BackgroundColor="#33FFFFFF"
                                                                        HorizontalOptions="Center">
                                                                    <Path WidthRequest="18" HeightRequest="18"
                                                                          Aspect="Uniform"
                                                                          Fill="Transparent"
                                                                          Stroke="White"
                                                                          StrokeThickness="2"
                                                                          StrokeLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          HorizontalOptions="Center"
                                                                          VerticalOptions="Center"
                                                                          Data="M14.06,9 L15,9.94 L5.92,19 H5 V18.08 L14.06,9 M17.66,3 C17.41,3 17.15,3.1 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C18.17,3.09 17.92,3 17.66,3 M14.06,6.19 L3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z" />
                                                                </Border>
                                                                <Label Text="Edit"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </SwipeItemView>

                                                </SwipeItems>
                                            </SwipeView.LeftItems>

                                            <!-- ══════════════════════════════════════════ -->
                                            <!-- RIGHT SWIPE (finger ←) → DELETE (Red)     -->
                                            <!-- ══════════════════════════════════════════ -->
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal"
                                                            SwipeBehaviorOnInvoked="Close">

                                                    <SwipeItemView>
                                                        <Grid WidthRequest="88"
                                                              BackgroundColor="#E63946">
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Grid.GestureRecognizers>

                                                            <VerticalStackLayout
                                                                VerticalOptions="Center"
                                                                HorizontalOptions="Center"
                                                                Spacing="6">
                                                                <Border WidthRequest="36" HeightRequest="36"
                                                                        StrokeThickness="0"
                                                                        StrokeShape="RoundRectangle 18"
                                                                        BackgroundColor="#33FFFFFF"
                                                                        HorizontalOptions="Center">
                                                                    <Image Source="icon_delete_white.png"
                                                                           WidthRequest="18" HeightRequest="18"
                                                                           Aspect="AspectFit"
                                                                           HorizontalOptions="Center"
                                                                           VerticalOptions="Center" />
                                                                </Border>
                                                                <Label Text="Delete"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </SwipeItemView>

                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <!-- ══════════════════════════════════════ -->
                                            <!--  PREMIUM BUDGET CARD                   -->
                                            <!-- ══════════════════════════════════════ -->
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18">
                                                <Border.Shadow>
                                                    <Shadow Brush="#3D1E00" Offset="0,6" Radius="16" Opacity="0.08" />
                                                </Border.Shadow>

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>

                                                <Grid ColumnDefinitions="5,*"
                                                      BackgroundColor="{StaticResource CardBg}">

                                                    <!-- LEFT ACCENT -->
                                                    <BoxView Grid.Column="0"
                                                             Color="{Binding ProgressColorValue}"
                                                             VerticalOptions="Fill" />

                                                    <!-- MAIN CONTENT -->
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Padding="14,12"
                                                                         Spacing="10">

                                                        <!-- Top row: icon + category + amount -->
                                                        <Grid ColumnDefinitions="44,*,Auto"
                                                              ColumnSpacing="12">

                                                            <!-- Icon (gradient) -->
                                                            <Border Grid.Column="0"
                                                                    WidthRequest="44" HeightRequest="44"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    StrokeShape="RoundRectangle 12">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="{StaticResource PrimaryTint}" Offset="0.0" />
                                                                        <GradientStop Color="{StaticResource WarningDeep}" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>

                                                                <Path WidthRequest="20" HeightRequest="20"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource Primary}"
                                                                      StrokeThickness="1.9"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      HorizontalOptions="Center"
                                                                      VerticalOptions="Center"
                                                                      Data="M3,7 L3,17 C3,18.1 3.9,19 5,19 L19,19 C20.1,19 21,18.1 21,17 L21,7 M3,7 L21,7 M3,7 L17,3 L21,7 M16,12 L20,12" />
                                                            </Border>

                                                            <!-- Category name -->
                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="3"
                                                                                 VerticalOptions="Center">
                                                                <Label FontSize="14.5" FontAttributes="Bold"
                                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                                       TextColor="{StaticResource TextPrimary}"
                                                                       Text="{Binding CategoryName, TargetNullValue='Budget'}" />

                                                                <Label FontSize="10.5"
                                                                       TextColor="{StaticResource TextSecondary}"
                                                                       Text="Monthly budget" />
                                                            </VerticalStackLayout>

                                                            <!-- Amount summary -->
                                                            <Label Grid.Column="2"
                                                                   FontSize="15.5" FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   HorizontalTextAlignment="End"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding Budget.AmountSummary}" />
                                                        </Grid>

                                                        <!-- Progress bar -->
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <Border Grid.Column="0"
                                                                    HeightRequest="8"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    BackgroundColor="{StaticResource TrackMuted}"
                                                                    StrokeShape="RoundRectangle 4">
                                                                <ProgressBar
                                                                    HeightRequest="8"
                                                                    BackgroundColor="Transparent"
                                                                    Progress="{Binding Budget.ProgressRatio}"
                                                                    ProgressColor="{Binding ProgressColorValue}" />
                                                            </Border>

                                                            <Label Grid.Column="1"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding Budget.ProgressRatio, StringFormat='{0:P0}'}" />
                                                        </Grid>

                                                        <!-- Bottom: remaining info -->
                                                        <Border Padding="9,6"
                                                                StrokeThickness="0"
                                                                HorizontalOptions="Start"
                                                                StrokeShape="RoundRectangle 8"
                                                                BackgroundColor="{StaticResource PrimaryTint}">
                                                            <HorizontalStackLayout Spacing="6">

                                                                <Path WidthRequest="11" HeightRequest="11"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource Primary}"
                                                                      StrokeThickness="2"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      VerticalOptions="Center"
                                                                      Data="M12,3 A9,9 0 1,1 3,12 A9,9 0 0,1 12,3 Z M12,11 L12,16 M12,8 L12,8.01" />

                                                                <Label FontSize="10.5"
                                                                       FontAttributes="Bold"
                                                                       VerticalOptions="Center"
                                                                       TextColor="{StaticResource Primary}"
                                                                       Text="{Binding Budget.RemainingText, TargetNullValue='On track'}" />
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </SwipeView>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.Footer>
                                    <BoxView HeightRequest="110" Color="Transparent" />
                                </CollectionView.Footer>
                            </CollectionView>

                        </Grid>
                    </RefreshView>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ FAB ═══════════ -->
        <Border WidthRequest="58"
                HeightRequest="58"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,24"
                StrokeShape="RoundRectangle 29">
            <Border.Shadow>
                <Shadow Brush="#FF6B00" Offset="0,8" Radius="18" Opacity="0.50" />
            </Border.Shadow>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8A1E" Offset="0.0" />
                    <GradientStop Color="#FF5500" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToAddCommand}" />
            </Border.GestureRecognizers>
            <Path WidthRequest="20" HeightRequest="20"
                  Aspect="Uniform"
                  Stroke="White"
                  StrokeThickness="2.8"
                  StrokeLineCap="Round"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Data="M12,4 L12,20 M4,12 L20,12" />
        </Border>

    </Grid>
</ContentPage>