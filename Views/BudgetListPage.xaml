<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.BudgetListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:components="clr-namespace:Arthiva.Views.Components"
    x:DataType="vm:BudgetListViewModel"
    Title="Budgets">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="16,12">

            <!-- Month navigation -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Button Grid.Column="0" Text="&#8249;" Style="{StaticResource SecondaryButton}"
                    WidthRequest="48" HeightRequest="48" Padding="0"
                    Command="{Binding PreviousMonthCommand}" />
                <Label Grid.Column="1" Style="{StaticResource SubtitleLabel}" Text="{Binding MonthYearLabel}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="&#8250;" Style="{StaticResource SecondaryButton}"
                    WidthRequest="48" HeightRequest="48" Padding="0"
                    Command="{Binding NextMonthCommand}" />
            </Grid>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">

                <CollectionView ItemsSource="{Binding Budgets}">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,60,0,0">
                            <Label Text="No budgets set for this month." Style="{StaticResource BodyLabel}"
                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BudgetListItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Edit"
                                               BackgroundColor="{StaticResource Primary}"
                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                               CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource Expense}"
                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                               CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- CardBorder → ListCardBorder: Shadow renders invisible inside CollectionView on Windows -->
                                <Border Style="{StaticResource ListCardBorder}" Margin="0,6">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Style="{StaticResource SubtitleLabel}" Text="{Binding CategoryName}" />
                                            <!-- MultiBinding removed — uses precomputed Budget.AmountSummary -->
                                            <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding Budget.AmountSummary}" />
                                        </Grid>

                                        <!-- MultiBinding removed — simple bindings to precomputed properties -->
                                        <ProgressBar Progress="{Binding Budget.ProgressRatio}"
                                                 ProgressColor="{Binding ProgressColorValue}" />

                                        <!-- MultiBinding removed — uses precomputed Budget.RemainingText -->
                                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding Budget.RemainingText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </RefreshView>

        </Grid>

        <Button Style="{StaticResource FabButton}" Text="+" Command="{Binding GoToAddCommand}" />
    </Grid>

</ContentPage>