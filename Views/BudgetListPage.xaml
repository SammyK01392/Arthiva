<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.BudgetListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    x:DataType="vm:BudgetListViewModel"
    Title="Budgets"
    BackgroundColor="#FFF8F2">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#FF6B00</Color>
            <Color x:Key="PrimaryTint">#FFF1E3</Color>
            <Color x:Key="PageBg">#FFF8F2</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#F4EBE1</Color>
            <Color x:Key="TrackMuted">#F4EDE6</Color>
            <Color x:Key="TextPrimary">#1A1410</Color>
            <Color x:Key="TextSecondary">#7A6B5E</Color>
            <Color x:Key="TextTertiary">#A89A8C</Color>
            <Color x:Key="Safe">#0FA968</Color>
            <Color x:Key="SafeTint">#E3F7EE</Color>
            <Color x:Key="SafeDeep">#C6EFDC</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="WarningTint">#FEF3C7</Color>
            <Color x:Key="WarningDeep">#FFE0C2</Color>
            <Color x:Key="Danger">#E63946</Color>
            <Color x:Key="DangerTint">#FDECEE</Color>
            <Color x:Key="DangerDeep">#FAD5DA</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid RowDefinitions="Auto,*">

            <!-- ═══════════ PREMIUM HEADER WITH MONTH NAV ═══════════ -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3D1E00" Offset="0.0" />
                        <GradientStop Color="#B84500" Offset="0.55" />
                        <GradientStop Color="#FF6B00" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Decorative SVG layer -->
                <Grid InputTransparent="True">
                    <Ellipse WidthRequest="140" HeightRequest="140"
                             Fill="#30FFB37A"
                             HorizontalOptions="Start" VerticalOptions="Start"
                             TranslationX="-50" TranslationY="-50" />

                    <Ellipse WidthRequest="200" HeightRequest="200"
                             Fill="#40FF8A1E"
                             HorizontalOptions="End" VerticalOptions="End"
                             TranslationX="80" TranslationY="80" />

                    <Path Stroke="#28FFFFFF" StrokeThickness="1.5" Fill="Transparent"
                          HorizontalOptions="End" VerticalOptions="Center"
                          TranslationX="30"
                          Data="M0,0 C 60,40 60,140 0,180" />

                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Start"
                                         VerticalOptions="Start"
                                         Margin="26,32,0,0">
                        <HorizontalStackLayout Spacing="8">
                            <Ellipse WidthRequest="3" HeightRequest="3" Fill="#66FFB37A" />
                            <Ellipse WidthRequest="3" HeightRequest="3" Fill="#40FFFFFF" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" Margin="10,0,0,0">
                            <Ellipse WidthRequest="3" HeightRequest="3" Fill="#40FFFFFF" />
                            <Ellipse WidthRequest="3" HeightRequest="3" Fill="#66FFB37A" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Header content -->
                <Grid Padding="22,26,22,26" ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="6">

                        <Border Padding="9,4"
                                StrokeThickness="0"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 7"
                                BackgroundColor="#40FF5500">
                            <HorizontalStackLayout Spacing="5">
                                <Ellipse WidthRequest="5" HeightRequest="5"
                                         Fill="#FFE0C2"
                                         VerticalOptions="Center" />
                                <Label Text="BUDGET PLANNER"
                                       FontSize="9.5"
                                       CharacterSpacing="2"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="#FFE0C2" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="Your Budgets"
                               FontSize="28"
                               FontAttributes="Bold"
                               Margin="0,8,0,0"
                               TextColor="White" />

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Spend smart,"
                                   FontSize="12"
                                   TextColor="#FFD9B8" />
                            <Label Text="stay on track"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#FFE0C2" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- ══ Premium wallet/chart SVG badge ══ -->
                    <Border Grid.Column="1"
                            WidthRequest="52" HeightRequest="52"
                            StrokeThickness="1"
                            Stroke="#30FFFFFF"
                            VerticalOptions="Center"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#30FFFFFF">
                        <Path WidthRequest="26" HeightRequest="26"
                              Aspect="Uniform"
                              Fill="Transparent"
                              Stroke="White"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M3,7 L3,17 C3,18.1 3.9,19 5,19 L19,19 C20.1,19 21,18.1 21,17 L21,7 M3,7 L21,7 M3,7 L17,3 L21,7 M16,12 L20,12" />
                    </Border>
                </Grid>

                <!-- ══ MONTH NAVIGATION BAR (inside header, bottom) ══ -->
                <Border Margin="22,0,22,20"
                        Padding="6"
                        StrokeThickness="1"
                        Stroke="#30FFFFFF"
                        VerticalOptions="End"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#25FFFFFF">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Previous SVG -->
                        <Border Grid.Column="0"
                                WidthRequest="38" HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#20FFFFFF">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousMonthCommand}" />
                            </Border.GestureRecognizers>
                            <Path WidthRequest="14" HeightRequest="14"
                                  Aspect="Uniform"
                                  Fill="Transparent"
                                  Stroke="White"
                                  StrokeThickness="2.4"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Data="M15,5 L8,12 L15,19" />
                        </Border>

                        <!-- Month label + tiny calendar -->
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="8"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <!-- Mini calendar SVG -->
                            <Path WidthRequest="14" HeightRequest="14"
                                  Aspect="Uniform"
                                  Fill="Transparent"
                                  Stroke="#FFE0C2"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalOptions="Center"
                                  Data="M5,7 L5,19 L19,19 L19,7 Z M5,10 L19,10 M9,3 L9,7 M15,3 L15,7" />

                            <Label Text="{Binding MonthYearLabel}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="White" />
                        </HorizontalStackLayout>

                        <!-- Next SVG -->
                        <Border Grid.Column="2"
                                WidthRequest="38" HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#20FFFFFF">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                            </Border.GestureRecognizers>
                            <Path WidthRequest="14" HeightRequest="14"
                                  Aspect="Uniform"
                                  Fill="Transparent"
                                  Stroke="White"
                                  StrokeThickness="2.4"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Data="M9,5 L16,12 L9,19" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════ CONTENT SHEET ═══════════ -->
            <Border Grid.Row="1" Margin="0,-14,0,0"
                    StrokeThickness="0" BackgroundColor="{StaticResource PageBg}"
                    StrokeShape="RoundRectangle 28,28,0,0">
                <Grid RowDefinitions="*">

                    <RefreshView Grid.Row="0"
                                 IsRefreshing="{Binding IsBusy}"
                                 Command="{Binding LoadCommand}"
                                 RefreshColor="{StaticResource Primary}">
                        <Grid>
                            <CollectionView ItemsSource="{Binding Budgets}"
                                            SelectionMode="None"
                                            VerticalScrollBarVisibility="Never"
                                            Margin="16,20,16,0">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="32" Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Margin="0,60,0,0">
                                        <Border WidthRequest="80" HeightRequest="80"
                                                StrokeThickness="0" HorizontalOptions="Center"
                                                StrokeShape="RoundRectangle 26"
                                                BackgroundColor="{StaticResource PrimaryTint}">
                                            <Path WidthRequest="34" HeightRequest="34"
                                                  Aspect="Uniform"
                                                  Fill="Transparent"
                                                  Stroke="{StaticResource Primary}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M3,7 L3,17 C3,18.1 3.9,19 5,19 L19,19 C20.1,19 21,18.1 21,17 L21,7 M3,7 L21,7 M3,7 L17,3 L21,7 M16,12 L20,12" />
                                        </Border>
                                        <Label Text="No budgets yet" FontSize="16"
                                               FontAttributes="Bold" HorizontalOptions="Center"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="Tap + to set your first budget."
                                               FontSize="12.5" HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BudgetListItem">

                                        <SwipeView Margin="0,0,0,12">
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItem Text="Edit"
                                                               BackgroundColor="{StaticResource Primary}"
                                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                               CommandParameter="{Binding .}" />
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="{StaticResource Danger}"
                                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                               CommandParameter="{Binding .}" />
                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <!-- ══════════════════════════════════════ -->
                                            <!--  PREMIUM BUDGET CARD                   -->
                                            <!-- ══════════════════════════════════════ -->
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18">
                                                <Border.Shadow>
                                                    <Shadow Brush="#3D1E00" Offset="0,6" Radius="16" Opacity="0.08" />
                                                </Border.Shadow>

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>

                                                <Grid ColumnDefinitions="5,*"
                                                      BackgroundColor="{StaticResource CardBg}">

                                                    <!-- ══ LEFT ACCENT (uses ProgressColorValue) ══ -->
                                                    <BoxView Grid.Column="0"
                                                             Color="{Binding ProgressColorValue}"
                                                             VerticalOptions="Fill" />

                                                    <!-- ══ MAIN CONTENT ══ -->
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Padding="14,12"
                                                                         Spacing="10">

                                                        <!-- ── Top row: icon + category + amount ── -->
                                                        <Grid ColumnDefinitions="44,*,Auto"
                                                              ColumnSpacing="12">

                                                            <!-- Icon (gradient) -->
                                                            <Border Grid.Column="0"
                                                                    WidthRequest="44" HeightRequest="44"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    StrokeShape="RoundRectangle 12">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="{StaticResource PrimaryTint}" Offset="0.0" />
                                                                        <GradientStop Color="{StaticResource WarningDeep}" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>

                                                                <!-- Piggy bank / wallet SVG -->
                                                                <Path WidthRequest="20" HeightRequest="20"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource Primary}"
                                                                      StrokeThickness="1.9"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      HorizontalOptions="Center"
                                                                      VerticalOptions="Center"
                                                                      Data="M3,7 L3,17 C3,18.1 3.9,19 5,19 L19,19 C20.1,19 21,18.1 21,17 L21,7 M3,7 L21,7 M3,7 L17,3 L21,7 M16,12 L20,12" />
                                                            </Border>

                                                            <!-- Category name + label -->
                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="3"
                                                                                 VerticalOptions="Center">
                                                                <Label FontSize="14.5" FontAttributes="Bold"
                                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                                       TextColor="{StaticResource TextPrimary}"
                                                                       Text="{Binding CategoryName, TargetNullValue='Budget'}" />

                                                                <Label FontSize="10.5"
                                                                       TextColor="{StaticResource TextSecondary}"
                                                                       Text="Monthly budget" />
                                                            </VerticalStackLayout>

                                                            <!-- Amount summary -->
                                                            <Label Grid.Column="2"
                                                                   FontSize="15.5" FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   HorizontalTextAlignment="End"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding Budget.AmountSummary}" />
                                                        </Grid>

                                                        <!-- ── Progress bar with % on side ── -->
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <Border Grid.Column="0"
                                                                    HeightRequest="8"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    BackgroundColor="{StaticResource TrackMuted}"
                                                                    StrokeShape="RoundRectangle 4">
                                                                <ProgressBar
                                                                    HeightRequest="8"
                                                                    BackgroundColor="Transparent"
                                                                    Progress="{Binding Budget.ProgressRatio}"
                                                                    ProgressColor="{Binding ProgressColorValue}" />
                                                            </Border>

                                                            <Label Grid.Column="1"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding Budget.ProgressRatio, StringFormat='{0:P0}'}" />
                                                        </Grid>

                                                        <!-- ── Bottom row: remaining info ── -->
                                                        <Border Padding="9,6"
                                                                StrokeThickness="0"
                                                                HorizontalOptions="Start"
                                                                StrokeShape="RoundRectangle 8"
                                                                BackgroundColor="{StaticResource PrimaryTint}">
                                                            <HorizontalStackLayout Spacing="6">

                                                                <!-- Info circle SVG -->
                                                                <Path WidthRequest="11" HeightRequest="11"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource Primary}"
                                                                      StrokeThickness="2"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      VerticalOptions="Center"
                                                                      Data="M12,3 A9,9 0 1,1 3,12 A9,9 0 0,1 12,3 Z M12,11 L12,16 M12,8 L12,8.01" />

                                                                <Label FontSize="10.5"
                                                                       FontAttributes="Bold"
                                                                       VerticalOptions="Center"
                                                                       TextColor="{StaticResource Primary}"
                                                                       Text="{Binding Budget.RemainingText, TargetNullValue='On track'}" />
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </SwipeView>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.Footer>
                                    <BoxView HeightRequest="110" Color="Transparent" />
                                </CollectionView.Footer>
                            </CollectionView>

                        </Grid>
                    </RefreshView>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ FAB ═══════════ -->
        <Border WidthRequest="58"
                HeightRequest="58"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,24"
                StrokeShape="RoundRectangle 29">
            <Border.Shadow>
                <Shadow Brush="#FF6B00" Offset="0,8" Radius="18" Opacity="0.50" />
            </Border.Shadow>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8A1E" Offset="0.0" />
                    <GradientStop Color="#FF5500" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToAddCommand}" />
            </Border.GestureRecognizers>
            <Path WidthRequest="20" HeightRequest="20"
                  Aspect="Uniform"
                  Stroke="White"
                  StrokeThickness="2.8"
                  StrokeLineCap="Round"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Data="M12,4 L12,20 M4,12 L20,12" />
        </Border>

    </Grid>
</ContentPage>