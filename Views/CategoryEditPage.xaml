<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.CategoryEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    x:DataType="vm:CategoryEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource FormLabel}" Text="CATEGORY NAME" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding Name}" Placeholder="e.g. Groceries" />

            <Label Style="{StaticResource FormLabel}" Text="TYPE" />
            <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />

            <Label Style="{StaticResource FormLabel}" Text="COLOR" />
            <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ColorPresets}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                StrokeThickness="2" Stroke="Transparent"
                                BackgroundColor="{Binding .}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SetColorCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Style="{StaticResource FormLabel}" Text="DESCRIPTION (OPTIONAL)" />
            <Editor Style="{StaticResource FormEditor}" Text="{Binding Description}" HeightRequest="70" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Style="{StaticResource PrimaryButton}" Text="Save Category"
                    Command="{Binding SaveCommand}" Margin="0,10,0,0" />
            <Button Style="{StaticResource TextButton}" Text="Cancel"
                    Command="{Binding CancelCommand}" HorizontalOptions="Center" />

            <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
