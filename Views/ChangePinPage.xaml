<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MoneySpend.Views.ChangePinPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MoneySpend.Controls"
    Title="Change PIN">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF6EC" Offset="0.0" />
            <GradientStop Color="#FFFFFF" Offset="0.55" />
            <GradientStop Color="#FFFAF4" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*,Auto">

        <!-- Glow behind logo -->
        <Ellipse Grid.Row="0"
                 WidthRequest="300"
                 HeightRequest="300"
                 Fill="#FF6B00"
                 Opacity="0.08"
                 HorizontalOptions="Center"
                 VerticalOptions="Start"
                 TranslationY="-130"
                 InputTransparent="True" />

        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,20,24,12"
                                 Spacing="0"
                                 HorizontalOptions="Fill">

                <!-- LOGO -->
                <Border WidthRequest="112"
                        HeightRequest="112"
                        BackgroundColor="White"
                        Stroke="#F6E7D6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 32"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#FF6B00"
                                Opacity="0.22"
                                Offset="0,10"
                                Radius="24" />
                    </Border.Shadow>

                    <Image Source="headerlogo.png"
                           WidthRequest="88"
                           HeightRequest="88"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- HEADER -->
                <Label x:Name="HeaderLabel"
                       Margin="0,22,0,0"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#1A1410"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="SubHeaderLabel"
                       Margin="0,8,0,0"
                       FontSize="14"
                       TextColor="#8A7B6E"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       MaximumWidthRequest="300" />

                <!-- Error line (fixed 20px, no jumping) -->
                <Grid HeightRequest="20" Margin="0,10,0,0">
                    <Label x:Name="ErrorLabel"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#DC2626"
                           IsVisible="False"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- PIN PAD -->
                <controls:PinPadView x:Name="PinPad"
                                     Margin="0,8,0,0"
                                     HorizontalOptions="Center"
                                     PinChanged="OnPinPadChanged" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER -->
        <HorizontalStackLayout Grid.Row="1"
                               Spacing="8"
                               Padding="0,8,0,20"
                               HorizontalOptions="Center">
            <Ellipse WidthRequest="6"
                     HeightRequest="6"
                     Fill="#22C55E"
                     VerticalOptions="Center" />
            <Label Text="Your data stays secured on this device"
                   FontSize="12"
                   TextColor="#8A7B6E"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>