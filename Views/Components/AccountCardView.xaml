<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Arthiva.Views.Components.AccountCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Arthiva.Models"
    x:DataType="models:Account">

    <Border Style="{StaticResource CardBorder}" Margin="0,6">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource SubtitleLabel}"
                   Text="{Binding Name}" />

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipBorder}"
                    BackgroundColor="{StaticResource PrimaryTint}"
                    IsVisible="{Binding IsDefault}">
                <Label Style="{StaticResource ChipLabel}" TextColor="{StaticResource Primary}" Text="Default" />
            </Border>

            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Style="{StaticResource CaptionLabel}"
                   Text="{Binding Type}" />

            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                   Text="{Binding CurrentBalance, Converter={StaticResource CurrencyConverter}}" />

        </Grid>
    </Border>
</ContentView>
