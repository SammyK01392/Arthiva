<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Arthiva.Views.Components.SummaryCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border Style="{StaticResource CardBorder}">
        <VerticalStackLayout Spacing="6">

            <Label Style="{StaticResource CaptionLabel}"
                   Text="{Binding CardTitle, Source={x:Reference Root}}" />

            <Label FontSize="20" FontAttributes="Bold"
                   TextColor="{Binding AccentColor, Source={x:Reference Root}}"
                   Text="{Binding CardAmount, Source={x:Reference Root}}" />

        </VerticalStackLayout>
    </Border>
</ContentView>
