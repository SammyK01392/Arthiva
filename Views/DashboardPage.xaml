<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    xmlns:components="clr-namespace:Arthiva.Views.Components"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:DashboardViewModel"
    Title="Home"
    BackgroundColor="{StaticResource Background}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,10,16,24" Spacing="14"
                                 MaximumWidthRequest="500"
                                 HorizontalOptions="Fill">

                <!-- ═══════════════════════════════════════════ -->
                <!-- GREETING (tight, compact)                   -->
                <!-- ═══════════════════════════════════════════ -->
                <VerticalStackLayout x:Name="GreetingSection" Spacing="1"
                                     Opacity="0" TranslationY="16">
                    <Label FontSize="12" TextColor="{StaticResource TextSecondary}"
                           Text="{Binding GreetingPrefix, StringFormat='{0},'}" />
                    <Label FontSize="22" FontAttributes="Bold" TextColor="#1A2B4C"
                           LineBreakMode="TailTruncation">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} 👋">
                                <Binding Path="UserName" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Label FontSize="11" TextColor="{StaticResource TextSecondary}"
                           Text="Small steps today, big dreams tomorrow." />
                </VerticalStackLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- TOTAL BALANCE CARD                          -->
                <!-- ═══════════════════════════════════════════ -->
                <Border x:Name="BalanceCard" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        Padding="0" Opacity="0" TranslationY="20">
                    <Border.Shadow>
                        <Shadow Brush="#FF5500" Offset="0,6" Radius="16" Opacity="0.25" />
                    </Border.Shadow>

                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8A00" Offset="0.0" />
                                <GradientStop Color="#FF5500" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <shapes:Path x:Name="Wave1"
                                     Data="M0,80 C100,30 200,110 320,50 C400,10 460,60 500,40 L500,200 L0,200 Z"
                                     Fill="#15FFFFFF" Aspect="Fill"
                                     HorizontalOptions="Fill" VerticalOptions="End" />
                        <shapes:Path x:Name="Wave2"
                                     Data="M0,110 C120,60 220,140 340,80 C420,40 480,90 500,70 L500,200 L0,200 Z"
                                     Fill="#22FFFFFF" Aspect="Fill"
                                     HorizontalOptions="Fill" VerticalOptions="End" />

                        <VerticalStackLayout Padding="16" Spacing="10">

                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="Total Balance" TextColor="White"
                                       Opacity="0.92" FontSize="12" VerticalOptions="Center" />
                                <Image x:Name="EyeIcon" Source="icon_eye.png"
                                       WidthRequest="15" HeightRequest="15"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" Opacity="0.9">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEyeIconTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 21"
                                        BackgroundColor="#33FFFFFF" VerticalOptions="Center">
                                    <Image Source="icon_wallet.png"
                                           WidthRequest="20" HeightRequest="20"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label x:Name="BalanceAmountLabel" Grid.Column="1"
                                       Text="₹0.00"
                                       TextColor="White"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Across all accounts"
                                       FontSize="11"
                                       TextColor="White" Opacity="0.85"
                                       VerticalOptions="Center" />
                                <Border x:Name="ViewAccountsButton" Grid.Column="1"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                        BackgroundColor="#44FFFFFF" Padding="12,7">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewAccountsTapped" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Text="View Accounts" FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" />
                                        <Image Source="icon_chevron_white.png"
                                               WidthRequest="10" HeightRequest="10"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- QUICK ACTIONS — Premium tappable tiles      -->
                <!-- Each tile is a mini-card with border +     -->
                <!-- tinted background so it visibly navigates. -->
                <!-- ═══════════════════════════════════════════ -->
                <Border x:Name="QuickActionsSection"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="White" Padding="14"
                        Opacity="0" TranslationY="18">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="12" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <!-- Header row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Quick Actions"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Tap to add"
                                   FontSize="10.5"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- 4 x 2 grid of tappable tiles -->
                        <Grid ColumnDefinitions="*,*,*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="8" RowSpacing="8">

                            <!-- ──────── INCOME ──────── -->
                            <Border Grid.Row="0" Grid.Column="0"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#F7FBF8"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickAddIncomeTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#D7F0E2"
                    HorizontalOptions="Center">

                                        <!-- Income : Bar Chart + Growth Arrow -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#059669"
                             StrokeThickness="2"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M4,20 V16 H7 V20
                                   M10,20 V12 H13 V20
                                   M16,20 V8 H19 V20
                                   M4,12 L9,8 L13,10 L20,4
                                   M16,4 H20 V8" />

                                    </Border>

                                    <Label Text="Income"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- ──────── EXPENSE ──────── -->
                            <Border Grid.Row="0" Grid.Column="1"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#FDF8F8"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickAddExpenseTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#FBDDE1"
                    HorizontalOptions="Center">

                                        <!-- Expense : Wallet + Outgoing Arrow -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#DC2626"
                             StrokeThickness="2"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M4,9
                                   C4,7.9 4.9,7 6,7
                                   H15
                                   C16.1,7 17,7.9 17,9
                                   V18
                                   C17,19.1 16.1,20 15,20
                                   H6
                                   C4.9,20 4,19.1 4,18
                                   Z
                                   M12,12 H17
                                   M15,9 L21,3
                                   M17,3 H21 V7" />

                                    </Border>

                                    <Label Text="Expense"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- ──────── BORROW ──────── -->
                            <Border Grid.Row="0" Grid.Column="2"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#F7FAFE"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickBorrowTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#DBEAFE"
                    HorizontalOptions="Center">

                                        <!-- Borrow : Money Coming Into Wallet -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#2563EB"
                             StrokeThickness="1.9"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M4,10
                                   C4,8.9 4.9,8 6,8
                                   H18
                                   C19.1,8 20,8.9 20,10
                                   V18
                                   C20,19.1 19.1,20 18,20
                                   H6
                                   C4.9,20 4,19.1 4,18
                                   Z

                                   M15,12
                                   H20
                                   V16
                                   H15
                                   C13.9,16 13,15.1 13,14
                                   C13,12.9 13.9,12 15,12
                                   Z

                                   M8,3
                                   V7

                                   M5,4
                                   L8,7
                                   L11,4" />

                                    </Border>

                                    <Label Text="Borrow"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- ──────── LEND ──────── -->
                            <Border Grid.Row="0" Grid.Column="3"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#FAF7FE"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickLendTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#EDE2FE"
                    HorizontalOptions="Center">

                                        <!-- Lend : Coin + Giving Hand -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#7C3AED"
                             StrokeThickness="1.8"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M15,3
                                   C16.7,3 18,4.3 18,6
                                   C18,7.7 16.7,9 15,9
                                   C13.3,9 12,7.7 12,6
                                   C12,4.3 13.3,3 15,3
                                   Z

                                   M4,14
                                   H8
                                   L10,12
                                   H14
                                   C15.1,12 16,12.9 16,14
                                   C16,15.1 15.1,16 14,16
                                   H11

                                   M8,14
                                   L11,19
                                   H16
                                   L21,15

                                   C21.8,14.3 21.7,13.2 21,12.6
                                   C20.4,12.1 19.6,12.1 19,12.6
                                   L16,15" />

                                    </Border>

                                    <Label Text="Lend"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- ──────── EMI ──────── -->
                            <Border Grid.Row="1" Grid.Column="0"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#F7FAFE"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickEmiTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#DBEAFE"
                    HorizontalOptions="Center">

                                        <!-- EMI : Card + Recurring Installment -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#1E88E5"
                             StrokeThickness="1.9"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M4,7
                                   C4,5.9 4.9,5 6,5
                                   H18
                                   C19.1,5 20,5.9 20,7
                                   V17
                                   C20,18.1 19.1,19 18,19
                                   H6
                                   C4.9,19 4,18.1 4,17
                                   Z

                                   M4,9
                                   H20

                                   M7,14
                                   H11

                                   M14,13
                                   C15,12 17,12 18,13
                                   C19,14 19,16 18,17

                                   M18,17
                                   H15

                                   M18,17
                                   V14" />

                                    </Border>

                                    <Label Text="EMI"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- ──────── SAVING ──────── -->
                            <Border Grid.Row="1" Grid.Column="1"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#F7FBF8"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickSavingTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#D7F0E2"
                    HorizontalOptions="Center">

                                        <!-- Saving : Piggy Bank -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#0FA968"
                             StrokeThickness="1.8"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M5,11
                                   C5,8.2 7.5,6 11,6
                                   H14
                                   C17.4,6 20,8.3 20,11
                                   V14
                                   C20,16.2 18.2,18 16,18
                                   H9
                                   C6.2,18 4,15.8 4,13
                                   V12
                                   C4,11.4 4.4,11 5,11
                                   Z

                                   M10,6
                                   C10.5,4.7 11.5,4 13,4

                                   M16,9
                                   H16.01

                                   M8,18
                                   V20

                                   M17,18
                                   V20

                                   M20,11
                                   H22

                                   M9,9
                                   H14" />

                                    </Border>

                                    <Label Text="Saving"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- ──────── BUDGET ──────── -->
                            <Border Grid.Row="1" Grid.Column="2"
            StrokeThickness="1" Stroke="#EEF0F3"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#FAF7FE"
            Padding="4,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickBudgetTapped" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">

                                    <Border WidthRequest="38" HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="#EDE2FE"
                    HorizontalOptions="Center">

                                        <!-- Budget : Pie Chart -->
                                        <shapes:Path WidthRequest="22"
                             HeightRequest="22"
                             Aspect="Uniform"
                             Stroke="#8E24AA"
                             StrokeThickness="1.9"
                             StrokeLineCap="Round"
                             StrokeLineJoin="Round"
                             Fill="Transparent"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Data="M11,4
                                   C7.1,4.5 4,7.9 4,12
                                   C4,16.4 7.6,20 12,20
                                   C16.1,20 19.5,16.9 20,13
                                   H11
                                   Z

                                   M14,4
                                   C17.2,4.7 19.3,6.8 20,10
                                   H14
                                   Z" />

                                    </Border>

                                    <Label Text="Budget"
                   FontSize="10.5"
                   FontAttributes="Bold"
                   TextColor="#1A1410"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />

                                </VerticalStackLayout>

                            </Border>


                            <!-- Empty slot (intentional) -->
                            <Border Grid.Row="1" Grid.Column="3"
            StrokeThickness="0"
            BackgroundColor="Transparent" />

                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- PERIOD SWITCHER                             -->
                <!-- ═══════════════════════════════════════════ -->
                <Border StrokeThickness="1" Stroke="#EEF0F3"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="White" Padding="6,6">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="10" Opacity="0.05" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="40,*,40,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                StrokeThickness="1" Stroke="#E7E9ED"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="#FAFAFB">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousPeriodCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="‹" FontSize="18" FontAttributes="Bold"
                                   TextColor="#1A2B4C"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label Grid.Column="1" Text="{Binding PeriodLabel}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#1A2B4C"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />

                        <Border Grid.Column="2" WidthRequest="38" HeightRequest="38"
                                StrokeThickness="1" Stroke="#E7E9ED"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="#FAFAFB">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextPeriodCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="›" FontSize="18" FontAttributes="Bold"
                                   TextColor="#1A2B4C"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                BackgroundColor="#FFE9CC" Padding="12,8" Margin="4,0,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleViewModeCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding ViewModeLabel}" FontSize="11.5" FontAttributes="Bold"
                                   TextColor="#FF7A00" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- OVERVIEW SUMMARY CARDS                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Label Text="Overview" FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" Margin="2,2,0,-4" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="10" RowSpacing="10">

                    <components:SummaryCardView x:Name="CardIncome"
                        Grid.Row="0" Grid.Column="0"
                        IconSource="icon_arrow_up_green.png"
                        IconBackgroundColor="#E8F5E9" AccentColor="#00B368"
                        CardTitle="Income"
                        CardAmount="{Binding PeriodIncome, Converter={StaticResource CurrencyConverter}}"
                        CardCaption="{Binding PeriodIncomeCount, StringFormat='{0} transactions'}"
                        ShowDot="True" DotColor="#00B368"
                        Opacity="0" TranslationY="18" />

                    <components:SummaryCardView x:Name="CardExpense"
                        Grid.Row="0" Grid.Column="1"
                        IconSource="icon_arrow_down_red.png"
                        IconBackgroundColor="#FFEBEE" AccentColor="#E53935"
                        CardTitle="Expense"
                        CardAmount="{Binding PeriodExpense, Converter={StaticResource CurrencyConverter}}"
                        CardCaption="{Binding PeriodExpenseCount, StringFormat='{0} transactions'}"
                        ShowDot="True" DotColor="#E53935"
                        Opacity="0" TranslationY="18" />

                    <components:SummaryCardView x:Name="CardSavings"
                        Grid.Row="1" Grid.Column="0"
                        IconSource="icon_piggy_blue.png"
                        IconBackgroundColor="#E3F2FD" AccentColor="#1E88E5"
                        CardTitle="Savings"
                        CardAmount="{Binding PeriodSaving, Converter={StaticResource CurrencyConverter}}"
                        CardCaption="Income − Expense"
                        Opacity="0" TranslationY="18" />

                    <components:SummaryCardView x:Name="CardNetBalance"
                        Grid.Row="1" Grid.Column="1"
                        IconSource="icon_bank_purple.png"
                        IconBackgroundColor="#F3E5F5" AccentColor="#8E24AA"
                        CardTitle="Net Balance"
                        CardAmount="{Binding TotalBalance, Converter={StaticResource CurrencyConverter}}"
                        CardCaption="Cash + Bank + UPI"
                        Opacity="0" TranslationY="18" />
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- BORROW - LEND                               -->
                <!-- ═══════════════════════════════════════════ -->
                <Border x:Name="BorrowLendCard"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14"
                        Opacity="0" TranslationY="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBorrowLendTapped" />
                    </Border.GestureRecognizers>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFF8F0" Offset="0.0" />
                            <GradientStop Color="#FFEFE0" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#FF7A00" Offset="0,4" Radius="14" Opacity="0.10" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                StrokeThickness="0" StrokeShape="RoundRectangle 21"
                                BackgroundColor="#FFE0B2"
                                VerticalOptions="Center">
                            <Image Source="icon_users_orange.png"
                                   WidthRequest="20" HeightRequest="20"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                             VerticalOptions="Center">
                            <Label FontSize="14" FontAttributes="Bold"
                                   Text="Borrow - Lend"
                                   TextColor="#1A2B4C"
                                   LineBreakMode="TailTruncation" />
                            <Label FontSize="10"
                                   TextColor="#6B7A90"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   Text="Track what you owe and you're owed" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2" FontSize="15" FontAttributes="Bold"
                               TextColor="#FF7A00"
                               VerticalOptions="Center"
                               LineBreakMode="NoWrap"
                               Text="{Binding NetBorrowLend, Converter={StaticResource CurrencyConverter}}" />

                        <Image Grid.Column="3" Source="icon_chevron_orange.png"
                               WidthRequest="12" HeightRequest="12"
                               Aspect="AspectFit"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- RECENT TRANSACTIONS                         -->
                <!-- ═══════════════════════════════════════════ -->
                <Border x:Name="RecentTransactionsCard"
                        Style="{StaticResource CardBorder}" Padding="4,0,4,12"
                        Opacity="0" TranslationY="18"
                        IsVisible="{Binding RecentTransactions.Count, Converter={StaticResource CountToBoolConverter}}">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="12" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="12,12,12,8">
                            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                    BackgroundColor="#E3F2FD" VerticalOptions="Center">
                                <Image Source="icon_calendar_blue.png"
                                       WidthRequest="15" HeightRequest="15"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Recent Transactions"
                                   FontSize="13.5" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="View All ›"
                                   FontSize="11.5" FontAttributes="Bold"
                                   TextColor="#1E88E5"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecentTransactionsViewAllTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Spacing="0"
                            BindableLayout.ItemsSource="{Binding RecentTransactions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Transaction">
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" Padding="12,8">
                                        <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                                VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding TransactionType}" Value="Income">
                                                    <Setter Property="BackgroundColor" Value="#E8F5E9" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding TransactionType}" Value="Expense">
                                                    <Setter Property="BackgroundColor" Value="#FFEBEE" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Image Aspect="AspectFit" WidthRequest="18" HeightRequest="18"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding TransactionType}" Value="Income">
                                                        <Setter Property="Source" Value="icon_arrow_up_green.png" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Image" Binding="{Binding TransactionType}" Value="Expense">
                                                        <Setter Property="Source" Value="icon_arrow_down_red.png" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                            </Image>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   Text="{Binding Description, TargetNullValue='Transaction'}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label FontSize="10"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   Text="{Binding TransactionDate, StringFormat='{0:dd MMM, hh:mm tt}'}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" VerticalOptions="Center"
                                               FontSize="13.5" FontAttributes="Bold"
                                               LineBreakMode="NoWrap"
                                               Text="{Binding ., Converter={StaticResource TransactionAmountTextConverter}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding TransactionType}" Value="Income">
                                                    <Setter Property="TextColor" Value="#00B368" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding TransactionType}" Value="Expense">
                                                    <Setter Property="TextColor" Value="#E53935" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Padding="0,8"
                    IsVisible="{Binding RecentTransactions.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                    <Label Text="No transactions yet. Tap Add to record one."
                           FontSize="12" TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- UPCOMING BILLS + ACTIVE EMIs                -->
                <!-- ═══════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,8">

                    <!-- Upcoming Bills -->
                    <Border x:Name="BillsCard"
                            Style="{StaticResource CardBorder}" Padding="12"
                            Opacity="0" TranslationY="18"
                            IsVisible="{Binding UpcomingBills.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                <Border Grid.Column="0" WidthRequest="28" HeightRequest="28"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="#E3F2FD">
                                    <Image Source="icon_calendar_blue.png"
                                           WidthRequest="14" HeightRequest="14"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Upcoming Bills" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="View All ›"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#1E88E5"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUpcomingBillsViewAllTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout Spacing="0"
                                BindableLayout.ItemsSource="{Binding UpcomingBills}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Bill">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                              ColumnSpacing="8" Margin="0,4">
                                            <Label Grid.Row="0" Grid.Column="0" FontSize="12.5" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation"
                                                   Text="{Binding Name}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Row="0" Grid.Column="1" FontSize="12.5" FontAttributes="Bold"
                                                   TextColor="#E53935"
                                                   LineBreakMode="NoWrap"
                                                   Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   FontSize="10.5" TextColor="{StaticResource TextSecondary}"
                                                   Text="{Binding DueDate, StringFormat='Due {0:dd MMM}'}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Padding="0,4"
                        IsVisible="{Binding UpcomingBills.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                        <Label Text="No bills due in the next 7 days."
                               FontSize="11.5" TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Active EMIs -->
                    <Border x:Name="EmisCard"
                            Style="{StaticResource CardBorder}" Padding="12"
                            Opacity="0" TranslationY="18"
                            IsVisible="{Binding ActiveEmis.Count, Converter={StaticResource CountToBoolConverter}}">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                <Border Grid.Column="0" WidthRequest="28" HeightRequest="28"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="#E3F2FD">
                                    <Image Source="icon_card_blue.png"
                                           WidthRequest="14" HeightRequest="14"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Active EMIs" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="View All ›"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#1E88E5"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnActiveEmisViewAllTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout Spacing="0"
                                BindableLayout.ItemsSource="{Binding ActiveEmis}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:EmiMaster">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                              ColumnSpacing="8" Margin="0,4">
                                            <Label Grid.Row="0" Grid.Column="0" FontSize="12.5" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation"
                                                   Text="{Binding Title}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Row="0" Grid.Column="1" FontSize="12.5" FontAttributes="Bold"
                                                   LineBreakMode="NoWrap"
                                                   Text="{Binding EmiAmount, Converter={StaticResource CurrencyConverter}}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   FontSize="10.5" TextColor="{StaticResource TextSecondary}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} of {1} paid">
                                                        <Binding Path="PaidInstallment" />
                                                        <Binding Path="TotalInstallment" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Padding="0,4"
                        IsVisible="{Binding ActiveEmis.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                        <Label Text="No active EMIs."
                               FontSize="11.5" TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>