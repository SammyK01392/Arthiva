<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.EmiListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    xmlns:components="clr-namespace:Arthiva.Views.Components"
    x:DataType="vm:EmiListViewModel"
    Title="EMIs">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <Grid>
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="0">
                    <CollectionView ItemsSource="{Binding Emis}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:EmiMaster">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Pay"
                                                       BackgroundColor="{StaticResource Income}"
                                                       Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToPayCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="{StaticResource Expense}"
                                                       Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Style="{StaticResource SubtitleLabel}" Text="{Binding Title}" />
                                                <Border Grid.Column="1" Style="{StaticResource ChipBorder}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource IncomeTint}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Style="{StaticResource ChipLabel}" Text="{Binding Status}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="TextColor" Value="{StaticResource Income}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </Grid>

                                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding LoanProvider}" />

                                            <ProgressBar ProgressColor="{StaticResource Primary}">
                                                <ProgressBar.Progress>
                                                    <MultiBinding Converter="{StaticResource InstallmentRatioConverter}">
                                                        <Binding Path="PaidInstallment" />
                                                        <Binding Path="TotalInstallment" />
                                                    </MultiBinding>
                                                </ProgressBar.Progress>
                                            </ProgressBar>

                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Style="{StaticResource CaptionLabel}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} of {1} installments paid">
                                                            <Binding Path="PaidInstallment" />
                                                            <Binding Path="TotalInstallment" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                                <Label Grid.Column="1" FontAttributes="Bold"
                                                       Text="{Binding EmiAmount, Converter={StaticResource CurrencyConverter}}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                IsVisible="{Binding Emis.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                <Label Text="No EMIs yet. Tap + Add to track a loan." Style="{StaticResource BodyLabel}"
                       TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Button Style="{StaticResource FabButton}" Text="+" Command="{Binding GoToAddCommand}" />
        </Grid>
    </RefreshView>

</ContentPage>
