<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.EmiListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    x:DataType="vm:EmiListViewModel"
    Title="EMIs"
    BackgroundColor="#FFF8F2">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#FF6B00</Color>
            <Color x:Key="PrimaryTint">#FFF1E3</Color>
            <Color x:Key="PageBg">#FFF8F2</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#F4EBE1</Color>
            <Color x:Key="TextPrimary">#1A1410</Color>
            <Color x:Key="TextSecondary">#7A6B5E</Color>
            <Color x:Key="TextTertiary">#A89A8C</Color>
            <Color x:Key="Active">#FF6B00</Color>
            <Color x:Key="ActiveTint">#FFF1E3</Color>
            <Color x:Key="ActiveDeep">#FFE0C2</Color>
            <Color x:Key="Completed">#0FA968</Color>
            <Color x:Key="CompletedTint">#E3F7EE</Color>
            <Color x:Key="CompletedDeep">#C6EFDC</Color>
            <Color x:Key="TrackMuted">#F4EDE6</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <Grid RowDefinitions="Auto,*">

            <!-- ═══════════ COMPACT PREMIUM HEADER ═══════════ -->
            <Grid Grid.Row="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8A1E" Offset="0.0" />
                        <GradientStop Color="#FF6B00" Offset="0.55" />
                        <GradientStop Color="#F25600" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Decorative SVG layer -->
                <Grid InputTransparent="True">
                    <Ellipse WidthRequest="100" HeightRequest="100"
                             Fill="#30FFFFFF"
                             HorizontalOptions="Start" VerticalOptions="Start"
                             TranslationX="-40" TranslationY="-40" />

                    <Ellipse WidthRequest="140" HeightRequest="140"
                             Fill="#40FFFFFF"
                             HorizontalOptions="End" VerticalOptions="End"
                             TranslationX="60" TranslationY="60" />

                    <Path Stroke="#28FFFFFF" StrokeThickness="1.3" Fill="Transparent"
                          HorizontalOptions="End" VerticalOptions="Center"
                          TranslationX="20"
                          Data="M0,0 C 40,30 40,100 0,130" />

                    <HorizontalStackLayout Spacing="6"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="20,18,0,0">
                        <Ellipse WidthRequest="3" HeightRequest="3" Fill="#66FFE0C2" />
                        <Ellipse WidthRequest="3" HeightRequest="3" Fill="#40FFFFFF" />
                        <Ellipse WidthRequest="3" HeightRequest="3" Fill="#40FFFFFF" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Header content — compact -->
                <Grid Padding="20,16,20,18" ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="3">

                        <Border Padding="7,3"
                                StrokeThickness="0"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="#40FFFFFF">
                            <HorizontalStackLayout Spacing="4">
                                <Ellipse WidthRequest="4" HeightRequest="4"
                                         Fill="#FFE0C2"
                                         VerticalOptions="Center" />
                                <Label Text="EMI TRACKER"
                                       FontSize="8.5"
                                       CharacterSpacing="1.8"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="#FFE0C2" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="Your EMIs"
                               FontSize="22"
                               FontAttributes="Bold"
                               Margin="0,4,0,0"
                               TextColor="White" />

                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Track loans,"
                                   FontSize="11"
                                   TextColor="#FFE0C2" />
                            <Label Text="plan every payment"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Pie Chart SVG badge — smaller -->
                    <Border Grid.Column="1"
                            WidthRequest="42" HeightRequest="42"
                            StrokeThickness="1"
                            Stroke="#40FFFFFF"
                            VerticalOptions="Center"
                            StrokeShape="RoundRectangle 13"
                            BackgroundColor="#40FFFFFF">
                        <Path WidthRequest="20" HeightRequest="20"
                              Aspect="Uniform"
                              Fill="Transparent"
                              Stroke="White"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M12,3 A9,9 0 1,1 3,12 M12,3 L12,12 L21,12 M12,12 L12,3" />
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════ CONTENT SHEET ═══════════ -->
            <Border Grid.Row="1" Margin="0,-12,0,0"
                    StrokeThickness="0" BackgroundColor="{StaticResource PageBg}"
                    StrokeShape="RoundRectangle 26,26,0,0">
                <Grid RowDefinitions="*">

                    <RefreshView Grid.Row="0"
                                 IsRefreshing="{Binding IsBusy}"
                                 Command="{Binding LoadCommand}"
                                 RefreshColor="{StaticResource Primary}">
                        <Grid>
                            <CollectionView ItemsSource="{Binding Emis}"
                                            SelectionMode="None"
                                            VerticalScrollBarVisibility="Never"
                                            Margin="16,16,16,0">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="32" Spacing="12"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Margin="0,60,0,0">
                                        <Border WidthRequest="80" HeightRequest="80"
                                                StrokeThickness="0" HorizontalOptions="Center"
                                                StrokeShape="RoundRectangle 26"
                                                BackgroundColor="{StaticResource PrimaryTint}">
                                            <Path WidthRequest="34" HeightRequest="34"
                                                  Aspect="Uniform"
                                                  Fill="Transparent"
                                                  Stroke="{StaticResource Primary}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M12,3 A9,9 0 1,1 3,12 M12,3 L12,12 L21,12" />
                                        </Border>
                                        <Label Text="No EMIs yet" FontSize="16"
                                               FontAttributes="Bold" HorizontalOptions="Center"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="Tap + to add your first EMI."
                                               FontSize="12.5" HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EmiMaster">

                                        <SwipeView Margin="0,0,0,12">
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItem Text="Pay"
                                                               BackgroundColor="{StaticResource Completed}"
                                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToPayCommand}"
                                                               CommandParameter="{Binding .}" />
                                                    <SwipeItem Text="Delete"
                                                               BackgroundColor="#E63946"
                                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                               CommandParameter="{Binding .}" />
                                                </SwipeItems>
                                            </SwipeView.RightItems>

                                            <!-- PREMIUM EMI CARD -->
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18">
                                                <Border.Shadow>
                                                    <Shadow Brush="#3D1E00" Offset="0,6" Radius="16" Opacity="0.08" />
                                                </Border.Shadow>

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToDetailCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>

                                                <Grid ColumnDefinitions="5,*"
                                                      BackgroundColor="{StaticResource CardBg}">

                                                    <!-- LEFT STATUS ACCENT -->
                                                    <Grid Grid.Column="0">
                                                        <BoxView Color="{StaticResource TrackMuted}"
                                                                 VerticalOptions="Fill" />
                                                        <BoxView Color="{StaticResource Active}"
                                                                 VerticalOptions="Start"
                                                                 HeightRequest="100">
                                                            <BoxView.Triggers>
                                                                <DataTrigger TargetType="BoxView"
                                                                             Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Color" Value="{StaticResource Completed}" />
                                                                </DataTrigger>
                                                            </BoxView.Triggers>
                                                        </BoxView>
                                                    </Grid>

                                                    <!-- MAIN CONTENT -->
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Padding="14,12"
                                                                         Spacing="10">

                                                        <Grid ColumnDefinitions="44,*,Auto"
                                                              ColumnSpacing="12">

                                                            <Border Grid.Column="0"
                                                                    WidthRequest="44" HeightRequest="44"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    StrokeShape="RoundRectangle 12">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="{StaticResource PrimaryTint}" Offset="0.0" />
                                                                        <GradientStop Color="{StaticResource ActiveDeep}" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border"
                                                                                 Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="{StaticResource CompletedTint}" Offset="0.0" />
                                                                                    <GradientStop Color="{StaticResource CompletedDeep}" Offset="1.0" />
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Border.Triggers>

                                                                <Path WidthRequest="20" HeightRequest="20"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource Primary}"
                                                                      StrokeThickness="1.9"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      HorizontalOptions="Center"
                                                                      VerticalOptions="Center"
                                                                      Data="M3,10 L12,4 L21,10 M5,10 L5,20 L19,20 L19,10 M9,20 L9,14 L15,14 L15,20 M9,13 L9,13.01 M15,13 L15,13.01">
                                                                    <Path.Triggers>
                                                                        <DataTrigger TargetType="Path"
                                                                                     Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="Stroke" Value="{StaticResource Completed}" />
                                                                        </DataTrigger>
                                                                    </Path.Triggers>
                                                                </Path>
                                                            </Border>

                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="3"
                                                                                 VerticalOptions="Center">
                                                                <Label FontSize="14.5" FontAttributes="Bold"
                                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                                       TextColor="{StaticResource TextPrimary}"
                                                                       Text="{Binding Title, TargetNullValue='EMI'}" />

                                                                <Label FontSize="10.5"
                                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                                       TextColor="{StaticResource TextSecondary}"
                                                                       Text="{Binding LoanProvider}"
                                                                       IsVisible="{Binding LoanProvider, Converter={StaticResource StringNotEmptyConverter}}" />
                                                            </VerticalStackLayout>

                                                            <Border Grid.Column="2"
                                                                    Padding="8,3"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Start"
                                                                    StrokeShape="RoundRectangle 7"
                                                                    BackgroundColor="{StaticResource ActiveTint}">
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border"
                                                                                 Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="BackgroundColor" Value="{StaticResource CompletedTint}" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <HorizontalStackLayout Spacing="5">
                                                                    <Ellipse WidthRequest="5" HeightRequest="5"
                                                                             Fill="{StaticResource Active}"
                                                                             VerticalOptions="Center">
                                                                        <Ellipse.Triggers>
                                                                            <DataTrigger TargetType="Ellipse"
                                                                                         Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="Fill" Value="{StaticResource Completed}" />
                                                                            </DataTrigger>
                                                                        </Ellipse.Triggers>
                                                                    </Ellipse>
                                                                    <Label FontSize="9.5" FontAttributes="Bold"
                                                                           VerticalOptions="Center"
                                                                           TextColor="{StaticResource Active}"
                                                                           Text="{Binding Status}">
                                                                        <Label.Triggers>
                                                                            <DataTrigger TargetType="Label"
                                                                                         Binding="{Binding Status}" Value="Completed">
                                                                                <Setter Property="TextColor" Value="{StaticResource Completed}" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </HorizontalStackLayout>
                                                            </Border>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <Border Grid.Column="0"
                                                                    HeightRequest="8"
                                                                    StrokeThickness="0"
                                                                    VerticalOptions="Center"
                                                                    BackgroundColor="{StaticResource TrackMuted}"
                                                                    StrokeShape="RoundRectangle 4">
                                                                <ProgressBar
                                                                    HeightRequest="8"
                                                                    ProgressColor="{StaticResource Active}"
                                                                    Progress="{Binding ProgressRatio}"
                                                                    BackgroundColor="Transparent">
                                                                    <ProgressBar.Triggers>
                                                                        <DataTrigger TargetType="ProgressBar"
                                                                                     Binding="{Binding Status}" Value="Completed">
                                                                            <Setter Property="ProgressColor" Value="{StaticResource Completed}" />
                                                                        </DataTrigger>
                                                                    </ProgressBar.Triggers>
                                                                </ProgressBar>
                                                            </Border>

                                                            <Label Grid.Column="1"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding ProgressRatio, StringFormat='{0:P0}'}" />
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <HorizontalStackLayout Grid.Column="0"
                                                                                   Spacing="6"
                                                                                   VerticalOptions="Center">
                                                                <Path WidthRequest="12" HeightRequest="12"
                                                                      Aspect="Uniform"
                                                                      Fill="Transparent"
                                                                      Stroke="{StaticResource TextTertiary}"
                                                                      StrokeThickness="2"
                                                                      StrokeLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      VerticalOptions="Center"
                                                                      Data="M5,7 L5,19 L19,19 L19,7 Z M5,10 L19,10 M9,3 L9,7 M15,3 L15,7" />

                                                                <Label FontSize="11"
                                                                       TextColor="{StaticResource TextSecondary}"
                                                                       VerticalOptions="Center"
                                                                       Text="{Binding InstallmentSummary}" />
                                                            </HorizontalStackLayout>

                                                            <Label Grid.Column="1"
                                                                   FontSize="15.5" FontAttributes="Bold"
                                                                   HorizontalTextAlignment="End"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   Text="{Binding EmiAmount, Converter={StaticResource CurrencyConverter}}" />
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </SwipeView>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.Footer>
                                    <BoxView HeightRequest="110" Color="Transparent" />
                                </CollectionView.Footer>
                            </CollectionView>

                        </Grid>
                    </RefreshView>
                </Grid>
            </Border>
        </Grid>

        <!-- FAB -->
        <Border WidthRequest="58"
                HeightRequest="58"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,24"
                StrokeShape="RoundRectangle 29">
            <Border.Shadow>
                <Shadow Brush="#FF6B00" Offset="0,8" Radius="18" Opacity="0.50" />
            </Border.Shadow>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8A1E" Offset="0.0" />
                    <GradientStop Color="#FF5500" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToAddCommand}" />
            </Border.GestureRecognizers>
            <Path WidthRequest="20" HeightRequest="20"
                  Aspect="Uniform"
                  Stroke="White"
                  StrokeThickness="2.8"
                  StrokeLineCap="Round"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Data="M12,4 L12,20 M4,12 L20,12" />
        </Border>

    </Grid>
</ContentPage>