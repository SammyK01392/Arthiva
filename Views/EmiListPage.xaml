<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.EmiListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    x:DataType="vm:EmiListViewModel"
    Title="EMIs">

    <Grid RowDefinitions="*">

        <RefreshView
            Grid.Row="0"
            IsRefreshing="{Binding IsBusy}"
            Command="{Binding LoadCommand}">

            <CollectionView
                ItemsSource="{Binding Emis}"
                SelectionMode="None"
                Margin="16,8,16,0">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8"
                        Margin="0,60,0,0">

                        <Label Text="No EMIs yet." Style="{StaticResource BodyLabel}"
                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                        <Label Text="Tap + to add an EMI." Style="{StaticResource CaptionLabel}"
                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EmiMaster">

                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="💰 Pay" BackgroundColor="{StaticResource Income}"
                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToPayCommand}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="🗑 Delete" BackgroundColor="{StaticResource Expense}"
                                               Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Single tap target: goes to Detail page only -->
                            <Border Style="{StaticResource ListCardBorder}" Margin="0,6">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Style="{StaticResource SubtitleLabel}"
                                               Text="{Binding Title}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource ChipBorder}" Padding="10,4">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource IncomeTint}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Active">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Style="{StaticResource ChipLabel}" Text="{Binding Status}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="TextColor" Value="{StaticResource Income}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Active">
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding LoanProvider}"
                                           IsVisible="{Binding LoanProvider, Converter={StaticResource StringNotEmptyConverter}}" />

                                    <ProgressBar HeightRequest="8" ProgressColor="{StaticResource Primary}"
                                                 Progress="{Binding ProgressRatio}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Style="{StaticResource CaptionLabel}"
                                               Text="{Binding InstallmentSummary}" />
                                        <Label Grid.Column="1" FontAttributes="Bold"
                                               Text="{Binding EmiAmount, Converter={StaticResource CurrencyConverter}}" />
                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </SwipeView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

        <Button
            Grid.Row="0"
            Style="{StaticResource FabButton}"
            Text="+"
            Command="{Binding GoToAddCommand}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,20" />

    </Grid>

</ContentPage>