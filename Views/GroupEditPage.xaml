<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MoneySpend.Views.GroupEditPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MoneySpend.ViewModels"
    x:DataType="vm:GroupEditViewModel"
    Title="{Binding Title}"
    BackgroundColor="#FFFFFF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#FF6B00</Color>
            <Color x:Key="PrimaryTint">#FFF1E3</Color>
            <Color x:Key="CardBg">#FFF8F2</Color>
            <Color x:Key="CardStroke">#F4EBE1</Color>
            <Color x:Key="TextPrimary">#1A1410</Color>
            <Color x:Key="TextSecondary">#7A6B5E</Color>
            <Color x:Key="TextTertiary">#A89A8C</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="14">

                <!-- Name -->
                <Border Padding="14" StrokeThickness="1"
                        Stroke="{StaticResource CardStroke}"
                        BackgroundColor="{StaticResource CardBg}"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Group name" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Entry Text="{Binding GroupName}" Placeholder="Goa Trip, Flatmates..."
                               TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Members" FontSize="15" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="You are always in the group. Existing members stay locked."
                       FontSize="11.5" TextColor="{StaticResource TextSecondary}" />

                <!-- Search friends + quick add -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding ContactSearch}" Placeholder="Search friends"
                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />

                    <Border Grid.Column="1" Padding="12,9" StrokeThickness="1"
                            Stroke="{StaticResource Primary}"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAddFriendCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+ Add friend" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </Border>
                </Grid>

                <Border IsVisible="{Binding IsAddFriendOpen}"
                        Padding="14" StrokeThickness="1"
                        Stroke="{StaticResource Primary}"
                        BackgroundColor="{StaticResource PrimaryTint}"
                        StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="New friend" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Entry Text="{Binding NewFriendName}" Placeholder="Name"
                               TextColor="{StaticResource TextPrimary}" />

                        <Entry Text="{Binding NewFriendMobile}"
                               Placeholder="Mobile (optional, for WhatsApp reminders)"
                               Keyboard="Telephone" MaxLength="20"
                               TextColor="{StaticResource TextPrimary}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Cancel"
                                    Command="{Binding CancelAddFriendCommand}"
                                    BackgroundColor="White"
                                    TextColor="{StaticResource TextSecondary}"
                                    BorderColor="{StaticResource CardStroke}" BorderWidth="1"
                                    CornerRadius="12" HeightRequest="44" />
                            <Button Grid.Column="1" Text="Add &amp; select"
                                    Command="{Binding SaveFriendCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White" FontAttributes="Bold"
                                    CornerRadius="12" HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Members list -->
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding VisibleRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemberRow">
                            <Border Padding="8,4" StrokeThickness="1"
                                    Stroke="{StaticResource CardStroke}"
                                    BackgroundColor="{StaticResource CardBg}"
                                    StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding CanToggle}"
                                              Color="{StaticResource Primary}"
                                              VerticalOptions="Center" />

                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontSize="14" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource TextPrimary}" />

                                    <Border Grid.Column="2" Padding="10,5" StrokeThickness="1"
                                            Stroke="{StaticResource TextTertiary}"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            IsVisible="{Binding IsLocked}"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMemberCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Remove" FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Padding="16,10,16,16" StrokeThickness="0" BackgroundColor="White">
            <Button Text="Save Group"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="50" />
        </Border>
    </Grid>
</ContentPage>
