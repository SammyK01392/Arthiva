<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MoneySpend.Views.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="More"
    BackgroundColor="#F6F7FB">

    <ContentPage.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="#8A94A6" />
            <Setter Property="Margin" Value="6,0,4,8" />
        </Style>
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="14,2" />
        </Style>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="Auto,*,Auto" />
            <Setter Property="ColumnSpacing" Value="14" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="IconBox" TargetType="Border">
            <Setter Property="WidthRequest" Value="42" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
        </Style>
        <Style x:Key="RowTitle" TargetType="Label">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#111827" />
        </Style>
        <Style x:Key="RowSub" TargetType="Label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextColor" Value="#8A94A6" />
        </Style>
        <Style x:Key="Chevron" TargetType="Label">
            <Setter Property="Text" Value="&#8250;" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextColor" Value="#B8BFCC" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="#F1F3F8" />
            <Setter Property="Margin" Value="56,0,0,0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="22" MaximumWidthRequest="500">

            <!-- PROFILE -->
            <!-- PROFILE -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 22"
        BackgroundColor="White" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,3" Radius="10" Opacity="0.06" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" InputTransparent="True">

                    <!-- Avatar: photo if available, otherwise gradient placeholder -->
                    <Grid WidthRequest="58" HeightRequest="58" VerticalOptions="Center">
                        <Border x:Name="AvatarPlaceholder"
                    StrokeThickness="0" StrokeShape="RoundRectangle 29">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF9A1F" Offset="0" />
                                    <GradientStop Color="#FF5A00" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="&#128100;" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border StrokeThickness="2" Stroke="#FFE0C2" StrokeShape="RoundRectangle 29"
                    IsVisible="{Binding Source={x:Reference ProfileImage}, Path=IsVisible}">
                            <Image x:Name="ProfileImage" Aspect="AspectFill" IsVisible="False" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label x:Name="ProfileNameLabel" Text="My Profile"
                   FontSize="17" FontAttributes="Bold" TextColor="#111827"
                   LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label x:Name="ProfileSubLabel" Text="View and edit your details"
                   FontSize="11.5" TextColor="#8A94A6"
                   LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2" Text="&#8250;" FontSize="22" TextColor="#B8BFCC"
               VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- MONEY MANAGEMENT -->
            <VerticalStackLayout>
                <Label Style="{StaticResource SectionLabel}" Text="MONEY MANAGEMENT" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout Spacing="0">

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBillsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#E0F2FE">
                                <Label Text="&#128179;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Bills" />
                                <Label Style="{StaticResource RowSub}" Text="Due dates and payments" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEmiTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#FEF3C7">
                                <Label Text="&#127974;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="EMI" />
                                <Label Style="{StaticResource RowSub}" Text="Loans and installments" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBorrowLendTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#ECFDF5">
                                <Label Text="&#129309;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Borrow &amp; Lend" />
                                <Label Style="{StaticResource RowSub}" Text="Who owes what" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSavingGoalsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#FFF1E3">
                                <Label Text="&#127919;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Saving Goals" />
                                <Label Style="{StaticResource RowSub}" Text="Plan and track your goals" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBudgetTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#EDE9FE">
                                <Label Text="&#128176;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Budget" />
                                <Label Style="{StaticResource RowSub}" Text="Control your spending" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnContactsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#FFE4E6">
                                <Label Text="&#128100;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Contacts" />
                                <Label Style="{StaticResource RowSub}" Text="People you deal with" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoriesTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#FEF3C7">
                                <Label Text="&#127991;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Categories" />
                                <Label Style="{StaticResource RowSub}" Text="Organise income and expense" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- APP -->
            <VerticalStackLayout>
                <Label Style="{StaticResource SectionLabel}" Text="APP" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout Spacing="0">

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#F1F5F9">
                                <Label Text="&#9881;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Settings" />
                                <Label Style="{StaticResource RowSub}" Text="Reminders and app options" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSecurityTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#FFF1E3">
                                <Label Text="&#128274;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Security" />
                                <Label Style="{StaticResource RowSub}" Text="PIN and privacy" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackupRestoreTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#E0F2FE">
                                <Label Text="&#9729;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Backup &amp; Restore" />
                                <Label Style="{StaticResource RowSub}" Text="Keep your data safe" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShareCrashLogTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#FFE4E6">
                                <Label Text="&#128030;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="Share Crash Log" />
                                <Label Style="{StaticResource RowSub}" Text="Help us fix problems faster" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutDeveloperTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource IconBox}" BackgroundColor="#ECFDF5">
                                <Label Text="&#128104;&#8205;&#128187;" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                                <Label Style="{StaticResource RowTitle}" Text="About Developer" />
                                <Label Style="{StaticResource RowSub}" Text="App info and contact" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{StaticResource Chevron}" InputTransparent="True" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="MoneySpend v1.0" FontSize="11.5" TextColor="#9CA3AF"
                   HorizontalOptions="Center" Margin="0,4,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>