<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="More">

    <ContentPage.Resources>
        <Style x:Key="MenuRowBorder" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="MenuIconLabel" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="MenuTitleLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="MenuChevronLabel" TargetType="Label">
            <Setter Property="Text" Value="&#8250;" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- Profile -->
            <Border Style="{StaticResource MenuRowBorder}" StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#128100;" />
                    <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="My Profile" />
                    <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                </Grid>
            </Border>

            <!-- Money management -->
            <VerticalStackLayout Spacing="1">
                <Label Style="{StaticResource SectionHeaderLabel}" Text="MONEY MANAGEMENT" Margin="4,0,4,4" />

                <Border Style="{StaticResource MenuRowBorder}" StrokeShape="RoundRectangle 12,12,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBillsTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#128179;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Bills" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmiTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#127974;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="EMI" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBorrowLendTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#129309;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Borrow &amp; Lend" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSavingGoalsTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#127919;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Saving Goals" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBudgetTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#128176;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Budget" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactsTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#128100;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Contacts" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}" StrokeShape="RoundRectangle 0,0,12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoriesTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#127991;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Categories" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- App -->
            <VerticalStackLayout Spacing="1">
                <Label Style="{StaticResource SectionHeaderLabel}" Text="APP" Margin="4,0,4,4" />

                <Border Style="{StaticResource MenuRowBorder}" StrokeShape="RoundRectangle 12,12,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#9881;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Settings" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#128274;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Security" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
                <BoxView Style="{StaticResource Divider}" />

                <Border Style="{StaticResource MenuRowBorder}" StrokeShape="RoundRectangle 0,0,12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource MenuIconLabel}" Text="&#9729;" />
                        <Label Grid.Column="1" Style="{StaticResource MenuTitleLabel}" Text="Backup &amp; Restore" />
                        <Label Grid.Column="2" Style="{StaticResource MenuChevronLabel}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Label Style="{StaticResource CaptionLabel}" Text="Arthiva v1.0" HorizontalOptions="Center" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
