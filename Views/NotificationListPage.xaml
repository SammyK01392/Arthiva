<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.NotificationListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    xmlns:components="clr-namespace:Arthiva.Views.Components"
    x:DataType="vm:NotificationListViewModel"
    Title="Notifications">

    <Grid RowDefinitions="Auto,*" Padding="16,12">

        <!-- Unread-only toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <Label Grid.Column="0" Style="{StaticResource BodyLabel}" FontAttributes="Bold"
                   Text="Show unread only" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding ShowUnreadOnly}" OnColor="{StaticResource Primary}" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <Grid>
                <ScrollView>
                    <VerticalStackLayout Spacing="0">
                        <CollectionView ItemsSource="{Binding Notifications}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Notification">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems>
                                                <SwipeItem Text="Done"
                                                           BackgroundColor="{StaticResource Income}"
                                                           Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.MarkCompletedCommand}"
                                                           CommandParameter="{Binding .}" />
                                                <SwipeItem Text="Delete"
                                                           BackgroundColor="{StaticResource Expense}"
                                                           Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                           CommandParameter="{Binding .}" />
                                            </SwipeItems>
                                        </SwipeView.RightItems>

                                        <Border Style="{StaticResource CardBorder}" Margin="0,6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Grid ColumnDefinitions="10,*" ColumnSpacing="10">

                                                <!-- Unread dot -->
                                                <Ellipse Grid.Column="0" WidthRequest="8" HeightRequest="8"
                                                         Fill="{StaticResource PrimaryBrush}" VerticalOptions="Start" Margin="0,4,0,0">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsRead}" Value="True">
                                                            <Setter Property="Opacity" Value="0" />
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>

                                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                    <Label Style="{StaticResource SubtitleLabel}" Text="{Binding Title}" />
                                                    <Label Style="{StaticResource BodyLabel}" TextColor="{StaticResource TextSecondary}"
                                                           Text="{Binding Body}" LineBreakMode="TailTruncation" MaxLines="2" />
                                                    <Label Style="{StaticResource CaptionLabel}"
                                                           Text="{Binding ReminderDate, StringFormat='{0:dd MMM, hh:mm tt}'}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>

                <components:EmptyStateView Icon="&#128276;" Message="No notifications."
                    IsVisible="{Binding Notifications.Count, Converter={StaticResource CountToInverseBoolConverter}}" />
            </Grid>
        </RefreshView>

    </Grid>

</ContentPage>
