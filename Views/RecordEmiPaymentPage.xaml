<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.RecordEmiPaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    x:DataType="vm:RecordEmiPaymentViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- EMI reference card -->
            <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource PrimaryTint}">
                <VerticalStackLayout Spacing="2">
                    <Label Style="{StaticResource CaptionLabel}" Text="PAYING EMI FOR" />
                    <Label Style="{StaticResource SubtitleLabel}" Text="{Binding Emi.Title}" />
                    <Label Style="{StaticResource CaptionLabel}">
                        <Label.Text>
                            <MultiBinding StringFormat="Installment {0} of {1}">
                                <Binding Path="Emi.PaidInstallment" />
                                <Binding Path="Emi.TotalInstallment" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource FormLabel}" Text="AMOUNT PAID" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding Amount}" Keyboard="Numeric"
                   FontSize="22" FontAttributes="Bold" />

            <Label Style="{StaticResource FormLabel}" Text="PAYMENT DATE" />
            <DatePicker Style="{StaticResource FormDatePicker}" Date="{Binding PaymentDate}" />

            <Label Style="{StaticResource FormLabel}" Text="LATE FEE / PENALTY (OPTIONAL)" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding PenaltyAmount}" Keyboard="Numeric" Placeholder="0.00" />

            <Label Style="{StaticResource FormLabel}" Text="REMARKS (OPTIONAL)" />
            <Editor Style="{StaticResource FormEditor}" Text="{Binding Remarks}" HeightRequest="70" />

            <Label Style="{StaticResource CaptionLabel}"
                   Text="If this EMI has a linked account, a matching Expense transaction will be created automatically." />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Style="{StaticResource PrimaryButton}" Text="Confirm Payment"
                    Command="{Binding SaveCommand}" Margin="0,10,0,0" />
            <Button Style="{StaticResource TextButton}" Text="Cancel"
                    Command="{Binding CancelCommand}" HorizontalOptions="Center" />

            <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
