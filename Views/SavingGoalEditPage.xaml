<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.SavingGoalEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    x:DataType="vm:SavingGoalEditViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Style="{StaticResource FormLabel}" Text="GOAL NAME" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding Name}" Placeholder="e.g. New Bike, Emergency Fund" />

            <Label Style="{StaticResource FormLabel}" Text="TARGET AMOUNT" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding TargetAmount}" Keyboard="Numeric"
                   FontSize="22" FontAttributes="Bold" />

            <Label Style="{StaticResource FormLabel}" Text="TARGET DATE (OPTIONAL)" />
            <DatePicker Style="{StaticResource FormDatePicker}" Date="{Binding TargetDate}" />

            <Label Style="{StaticResource FormLabel}" Text="DESCRIPTION (OPTIONAL)" />
            <Editor Style="{StaticResource FormEditor}" Text="{Binding Description}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Style="{StaticResource PrimaryButton}" Text="Save Goal"
                    Command="{Binding SaveCommand}" Margin="0,10,0,0" />
            <Button Style="{StaticResource TextButton}" Text="Cancel"
                    Command="{Binding CancelCommand}" HorizontalOptions="Center" />

            <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
