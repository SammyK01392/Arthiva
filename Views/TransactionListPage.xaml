<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Arthiva.Views.TransactionListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Arthiva.ViewModels"
    xmlns:models="clr-namespace:Arthiva.Models"
    x:DataType="vm:TransactionListViewModel"
    Title="Transactions">

    <Grid>
    <Grid RowDefinitions="Auto,*" Padding="16,12">

        <!-- Filter chips: All / Income / Expense -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,12"
                                BindableLayout.ItemsSource="{Binding FilterOptions}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource ChipBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectedFilter}" Value="{Binding .}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SetFilterCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource ChipLabel}" Text="{Binding .}" TextColor="{StaticResource TextPrimary}" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <Grid>
                <CollectionView ItemsSource="{Binding Transactions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete"
                                                   BackgroundColor="{StaticResource Expense}"
                                                   Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid Padding="4,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToEditCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Inlined row (no custom ContentView) -->
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                                BackgroundColor="{StaticResource PrimaryTint}"
                                                VerticalOptions="Center">
                                            <Label Text="₹" FontSize="18" TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Style="{StaticResource BodyLabel}" FontAttributes="Bold"
                                                   Text="{Binding Description, TargetNullValue='Transaction'}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Style="{StaticResource CaptionLabel}"
                                                   Text="{Binding TransactionDate, StringFormat='{0:dd MMM, hh:mm tt}'}" />
                                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding TransactionType}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" VerticalOptions="Center"
                                               FontSize="15" FontAttributes="Bold"
                                               Text="{Binding Amount, StringFormat='₹{0:N2}'}" />
                                    </Grid>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Inlined empty state (no custom ContentView) -->
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                    IsVisible="{Binding Transactions.Count, Converter={StaticResource CountToInverseBoolConverter}}">
                    <Label Text="No transactions found." Style="{StaticResource BodyLabel}"
                           TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="20" />
            </Grid>
        </RefreshView>

    </Grid>

        <Button Style="{StaticResource FabButton}" Text="+" Command="{Binding GoToAddCommand}" />
    </Grid>

</ContentPage>
