<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MoneySpend.Views.UserProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MoneySpend.ViewModels"
    x:DataType="vm:UserProfileViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,0">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 50"
                        WidthRequest="100" HeightRequest="100"
                        BackgroundColor="{StaticResource PrimaryTint}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image Source="{Binding ProfileImageSource}" Aspect="AspectFill"
                               IsVisible="{Binding HasProfileImage}" />
                        <Label Text="&#128100;" FontSize="40"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding ShowPlaceholder}" />
                    </Grid>
                </Border>
                <Label Text="Change photo" FontSize="12"
                       TextColor="{StaticResource Primary}" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Label Style="{StaticResource FormLabel}" Text="FULL NAME" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding FullName}" Placeholder="e.g. Rahul Sharma" />

            <Label Style="{StaticResource FormLabel}" Text="MOBILE NUMBER" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding MobileNo}" Keyboard="Telephone" />

            <Label Style="{StaticResource FormLabel}" Text="EMAIL" />
            <Entry Style="{StaticResource FormEntry}" Text="{Binding Email}" Keyboard="Email" />

            <Label Style="{StaticResource FormLabel}" Text="CURRENCY" />
            <Picker Style="{StaticResource FormPicker}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding CurrencyCode}" />

            <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource Income}"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center" FontAttributes="Bold" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Expense}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Style="{StaticResource PrimaryButton}" Text="Save Profile"
                    Command="{Binding SaveCommand}" Margin="0,10,0,0" />

            <ActivityIndicator Style="{StaticResource LoadingIndicator}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>